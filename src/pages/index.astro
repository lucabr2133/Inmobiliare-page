---
import Layout from '../layouts/Layout.astro';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from '@/components/ui/card';
import { Input } from '@/components/ui/input';
---

<Layout title="Vision Seguridad Electrónica - Alarmas y Cámaras">
  <!-- Navbar -->
  <header class="bg-slate-950 border-b border-slate-800 sticky top-0 z-50">
    <div class="container mx-auto px-4 py-4 flex justify-between items-center">
      <div class="flex items-center gap-2">
        <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        </div>
        <span class="text-white font-bold text-xl tracking-tight">VISION <span class="text-blue-500">SEGURIDAD</span></span>
      </div>
      <nav class="hidden md:flex gap-6 text-slate-300">
        <a href="#inicio" class="hover:text-white transition-colors">Inicio</a>
        <a href="#servicios" class="hover:text-white transition-colors">Servicios</a>
        <a href="#contacto" class="hover:text-white transition-colors">Contacto</a>
      </nav>
      <Button className="bg-blue-600 hover:bg-blue-700 text-white cursor-pointer hidden md:inline-flex">Contactar</Button>
    </div>
  </header>

  <main class="bg-slate-950 text-slate-200 min-h-screen">
    <!-- Hero Section -->
    <section id="inicio" class="relative pt-20 pb-32 overflow-hidden">
      <!-- Background glow -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] md:w-[800px] h-[600px] md:h-[800px] bg-blue-600/15 rounded-full blur-[100px] pointer-events-none"></div>
      
      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl mx-auto text-center space-y-8">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-950/80 border border-blue-800/50 text-blue-300 text-sm font-medium mb-2">
            <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
            Monitoreo 24/7 disponible
          </div>
          
          <h1 class="text-5xl md:text-7xl font-extrabold text-white tracking-tight leading-tight">
            Venta e Instalación de <br class="hidden md:block" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-blue-600">Cámaras y Alarmas</span>
          </h1>
          
          <p class="text-xl text-slate-400 md:px-16 leading-relaxed">
            Protegemos lo que más valoras. Soluciones integrales en seguridad electrónica para empresas, comercios y hogares con la última tecnología del mercado.
          </p>
          
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-6">
            <Button size="lg" className="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white text-lg h-14 px-8 cursor-pointer shadow-lg shadow-blue-900/20">
              Solicitar Presupuesto
            </Button>
            <Button size="lg" variant="outline" className="w-full sm:w-auto border-slate-700 bg-slate-900 text-slate-300 hover:bg-slate-800 hover:text-white text-lg h-14 px-8 cursor-pointer">
              Ver Servicios
            </Button>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section id="servicios" class="py-24 bg-slate-900/50">
      <div class="container mx-auto px-4">
        <div class="text-center mb-16 space-y-4">
          <h2 class="text-3xl md:text-5xl font-bold text-white">Nuestros Servicios</h2>
          <p class="text-slate-400 max-w-2xl mx-auto text-lg">Sistemas de alta tecnología adaptados a tus necesidades de seguridad.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
          <Card className="bg-slate-900/80 border-slate-800 hover:border-blue-500/50 transition-all duration-300 hover:-translate-y-1">
            <CardHeader>
              <div class="w-12 h-12 bg-blue-900/50 rounded-lg flex items-center justify-center mb-4 border border-blue-800/50">
                <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
              </div>
              <CardTitle className="text-white text-xl">Cámaras de Vigilancia</CardTitle>
              <CardDescription className="text-slate-400 text-base mt-2">Circuitos cerrados (CCTV), cámaras IP de alta definición con visión nocturna y monitoreo remoto desde tu celular.</CardDescription>
            </CardHeader>
          </Card>

          <Card className="bg-slate-900/80 border-slate-800 hover:border-blue-500/50 transition-all duration-300 hover:-translate-y-1">
            <CardHeader>
              <div class="w-12 h-12 bg-blue-900/50 rounded-lg flex items-center justify-center mb-4 border border-blue-800/50">
                <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
              </div>
              <CardTitle className="text-white text-xl">Sistemas de Alarmas</CardTitle>
              <CardDescription className="text-slate-400 text-base mt-2">Alarmas inteligentes anti-intrusión con sensores de movimiento, contactos magnéticos y sirenas de alto impacto.</CardDescription>
            </CardHeader>
          </Card>

          <Card className="bg-slate-900/80 border-slate-800 hover:border-blue-500/50 transition-all duration-300 hover:-translate-y-1">
            <CardHeader>
              <div class="w-12 h-12 bg-blue-900/50 rounded-lg flex items-center justify-center mb-4 border border-blue-800/50">
                <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
              </div>
              <CardTitle className="text-white text-xl">Cercos Eléctricos</CardTitle>
              <CardDescription className="text-slate-400 text-base mt-2">Protección perimetral disuasiva y activa. Instalación segura y homologada bajo las normativas vigentes.</CardDescription>
            </CardHeader>
          </Card>

          <Card className="bg-slate-900/80 border-slate-800 hover:border-blue-500/50 transition-all duration-300 hover:-translate-y-1">
            <CardHeader>
              <div class="w-12 h-12 bg-blue-900/50 rounded-lg flex items-center justify-center mb-4 border border-blue-800/50">
                <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
              </div>
              <CardTitle className="text-white text-xl">Cerraduras Inteligentes</CardTitle>
              <CardDescription className="text-slate-400 text-base mt-2">Control de acceso sin llaves. Apertura por código, tarjeta, huella dactilar o a través de aplicación móvil.</CardDescription>
            </CardHeader>
          </Card>
          
          <Card className="bg-slate-900/80 border-slate-800 hover:border-blue-500/50 transition-all duration-300 hover:-translate-y-1 md:col-span-2 lg:col-span-1">
            <CardHeader>
              <div class="w-12 h-12 bg-blue-900/50 rounded-lg flex items-center justify-center mb-4 border border-blue-800/50">
                <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"></path></svg>
              </div>
              <CardTitle className="text-white text-xl">Datos Biométricos y Presentismo</CardTitle>
              <CardDescription className="text-slate-400 text-base mt-2">Soluciones para empresas. Registros de asistencia y control de personal mediante huella o reconocimiento facial.</CardDescription>
            </CardHeader>
          </Card>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contacto" class="py-24 relative overflow-hidden">
      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-5xl mx-auto bg-slate-900 border border-slate-800 rounded-3xl p-8 md:p-14 shadow-2xl shadow-blue-900/10">
          <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
            <div>
              <h3 class="text-3xl md:text-4xl font-bold text-white mb-4">Protege tu espacio hoy</h3>
              <p class="text-slate-400 text-lg mb-8">Déjanos tus datos o contáctanos directamente para un asesoramiento personalizado. Respondemos de inmediato.</p>
              
              <div class="space-y-8">
                <div class="flex items-center gap-5">
                  <div class="w-14 h-14 bg-blue-900/30 rounded-xl flex items-center justify-center border border-blue-800/30">
                    <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-slate-500 uppercase tracking-wider mb-1">Llamadas y Consultas</p>
                    <p class="text-2xl font-bold text-white">221-6145824</p>
                  </div>
                </div>
                
                <div class="flex items-center gap-5">
                  <div class="w-14 h-14 bg-green-900/20 rounded-xl flex items-center justify-center border border-green-800/30">
                    <svg class="w-6 h-6 text-green-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zM20.056 3.968C17.904 1.83 15.044.654 12.042.653c-6.269 0-11.365 5.093-11.367 11.361 0 1.979.507 3.914 1.473 5.632l-1.614 5.901 6.035-1.583c1.656.883 3.528 1.349 5.426 1.351h.005c6.265 0 11.362-5.093 11.364-11.362.001-3.037-1.181-5.892-3.308-8.034z"/></svg>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-slate-500 uppercase tracking-wider mb-1">WhatsApp directo</p>
                    <p class="text-2xl font-bold text-white">Consultas las 24hs</p>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="bg-slate-950 p-8 rounded-2xl border border-slate-800 shadow-xl relative">
              <div class="absolute -top-4 -right-4 w-24 h-24 bg-blue-600/10 rounded-full blur-2xl"></div>
              
              <h4 class="text-xl font-semibold text-white mb-6">Envíanos un mensaje</h4>
              <form class="space-y-5">
                <div class="space-y-2">
                  <label class="text-sm font-medium text-slate-400">Nombre completo</label>
                  <Input placeholder="Ej. Walter Ortiz" className="bg-slate-900 border-slate-700 text-white h-12 focus-visible:ring-blue-500" />
                </div>
                <div class="space-y-2">
                  <label class="text-sm font-medium text-slate-400">Teléfono</label>
                  <Input placeholder="Tu número de contacto" type="tel" className="bg-slate-900 border-slate-700 text-white h-12 focus-visible:ring-blue-500" />
                </div>
                <div class="space-y-2">
                  <label class="text-sm font-medium text-slate-400">Servicio de interés</label>
                  <select class="w-full h-12 rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500">
                    <option>Cámaras de Seguridad</option>
                    <option>Sistemas de Alarma</option>
                    <option>Cercos Eléctricos</option>
                    <option>Cerraduras Inteligentes</option>
                    <option>Otro</option>
                  </select>
                </div>
                <Button className="w-full bg-blue-600 hover:bg-blue-700 text-white h-12 text-base font-medium mt-2 shadow-lg shadow-blue-900/20 cursor-pointer">
                  Solicitar Asesoramiento
                </Button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <footer class="bg-slate-950 border-t border-slate-900 py-10 text-center text-slate-500">
    <div class="container mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 bg-blue-600 rounded flex items-center justify-center">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        </div>
        <span class="text-slate-300 font-bold tracking-tight text-sm">VISION <span class="text-blue-500">SEGURIDAD</span></span>
      </div>
      <p class="text-sm">© {new Date().getFullYear()} Vision Seguridad Electrónica. Todos los derechos reservados.</p>
      <div class="flex gap-4">
        <!-- Social placeholders -->
      </div>
    </div>
  </footer>
</Layout>
