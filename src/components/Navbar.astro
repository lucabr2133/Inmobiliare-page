---
---

<header class="nav" id="navbar">
  <div class="container nav__inner">
    <a href="#inicio" class="nav__brand">INMOBILIARE</a>

    <nav class="nav__menu">
      <a href="#nosotros" class="nav__link">La Firma</a>
      <a href="#servicios" class="nav__link">Servicios</a>
      <a href="#trayectoria" class="nav__link">Trayectoria</a>
      <a href="#equipo" class="nav__link">Equipo</a>
      <a href="#contacto" class="nav__link">Contacto</a>
    </nav>

    <div class="nav__actions">
      <a href="#contacto" class="btn btn-gold nav__cta">Consultar</a>
      <button class="nav__hamburger" id="nav-toggle" aria-label="Menú">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="nav__mobile" id="nav-mobile" hidden>
    <div class="nav__mobile-inner">
      <a href="#nosotros" class="nav__mobile-link">La Firma</a>
      <a href="#servicios" class="nav__mobile-link">Servicios</a>
      <a href="#trayectoria" class="nav__mobile-link">Trayectoria</a>
      <a href="#equipo" class="nav__mobile-link">Equipo</a>
      <a href="#contacto" class="nav__mobile-link">Contacto</a>
      <a href="#contacto" class="btn btn-gold" style="width:100%;margin-top:1.5rem;">Consultar</a>
    </div>
  </div>
</header>

<style>
.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: rgba(250, 250, 248, 0.92);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--color-border);
  transition: all 0.35s ease;
}

.nav.scrolled {
  box-shadow: 0 4px 20px rgba(0,0,0,0.06);
}

.nav__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: var(--navbar-h);
}

.nav__brand {
  font-family: var(--font-display);
  font-size: 1.35rem;
  font-weight: 400;
  color: var(--color-gold);
  letter-spacing: 0.2em;
  text-decoration: none;
}

.nav__menu { display: flex; gap: 2.5rem; }

.nav__link {
  font-size: 0.8rem;
  font-weight: 400;
  color: var(--color-text-light);
  text-decoration: none;
  letter-spacing: 0.04em;
  transition: color 0.25s ease;
}

.nav__link:hover { color: var(--color-gold); }

.nav__actions { display: flex; align-items: center; gap: 1rem; }
.nav__cta { padding: 0.55rem 1.4rem; font-size: 0.72rem; }

.nav__hamburger {
  display: none;
  background: none;
  border: none;
  width: 26px;
  height: 18px;
  flex-direction: column;
  justify-content: space-between;
  cursor: pointer;
}

.nav__hamburger span {
  width: 100%;
  height: 1.5px;
  background: var(--color-dark);
}

.nav__mobile {
  position: fixed;
  top: var(--navbar-h);
  inset-inline: 0;
  bottom: 0;
  background: var(--color-bg);
  padding: 2.5rem;
  z-index: 999;
}

.nav__mobile-inner {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.nav__mobile-link {
  font-family: var(--font-display);
  font-size: 1.8rem;
  color: var(--color-dark);
  text-decoration: none;
}

.nav__mobile-link:hover { color: var(--color-gold); }

@media (max-width: 960px) {
  .nav__menu, .nav__cta { display: none; }
  .nav__hamburger { display: flex; }
}
</style>

<script>
  const nav = document.getElementById('navbar');
  const toggle = document.getElementById('nav-toggle');
  const mobile = document.getElementById('nav-mobile');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) nav?.classList.add('scrolled');
    else nav?.classList.remove('scrolled');
  }, { passive: true });

  toggle?.addEventListener('click', () => {
    const h = mobile?.hasAttribute('hidden');
    if (h) mobile?.removeAttribute('hidden');
    else mobile?.setAttribute('hidden', '');
  });

  mobile?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => mobile?.setAttribute('hidden', ''));
  });
</script>
