---
// Navbar.astro — APEX Athletic Header (No Blue, Clean Links)
---

<header class="hud-nav" id="navbar">
  <!-- Top Ribbon -->
  <div class="hud-ribbon">
    <div class="container hud-ribbon__inner">
      <div class="hud-ribbon__status">
        <span class="pulse-dot"></span>
        <span class="hud-ribbon__txt">PALERMO SOHO // RECOLETA · BUENOS AIRES</span>
      </div>
      <div class="hud-ribbon__time" id="live-time">
        BA: --:--:-- GMT-3
      </div>
    </div>
  </div>

  <!-- Main Navbar -->
  <div class="container hud-nav__inner">
    <!-- Brand -->
    <a href="#inicio" class="hud-nav__brand" aria-label="APEX Athletic Club">
      <div class="hud-nav__icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <path d="M13 2L3 14H12L11 22L21 10H12L13 2Z" fill="#D9FF00"/>
        </svg>
      </div>
      <div class="hud-nav__titles">
        <span class="hud-nav__name">APEX</span>
        <span class="hud-nav__sub">ATHLETIC CLUB</span>
      </div>
    </a>

    <!-- Nav Items -->
    <nav class="hud-nav__menu" aria-label="Navegación principal">
      <a href="#zonas" class="hud-nav__link">Zonas</a>
      <a href="#disciplinas" class="hud-nav__link">Disciplinas</a>
      <a href="#horarios" class="hud-nav__link">Horarios</a>
      <a href="#coaches" class="hud-nav__link">Coaches</a>
      <a href="#biohacking" class="hud-nav__link">Biohacking</a>
      <a href="#membresias" class="hud-nav__link">Pases</a>
    </nav>

    <!-- Action -->
    <div class="hud-nav__actions">
      <a href="#vip-pass" class="btn btn-volt hud-nav__btn">
        <span>VIP PASS</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <button class="hud-nav__hamburger" id="nav-toggle" aria-label="Abrir menú móvil">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="hud-mobile-menu" id="hud-mobile" hidden>
    <div class="hud-mobile-nav">
      <a href="#zonas" class="hud-mobile-link">ZONAS</a>
      <a href="#disciplinas" class="hud-mobile-link">DISCIPLINAS</a>
      <a href="#horarios" class="hud-mobile-link">HORARIOS</a>
      <a href="#coaches" class="hud-mobile-link">COACHES</a>
      <a href="#biohacking" class="hud-mobile-link">BIOHACKING</a>
      <a href="#membresias" class="hud-mobile-link">PASES</a>
      <a href="#vip-pass" class="btn btn-volt" style="margin-top:1.5rem;width:100%;">SOLICITAR 1-DAY PASS</a>
    </div>
  </div>
</header>

<style>
.hud-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  transition: all 0.35s ease;
  background: rgba(8, 10, 14, 0.85);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.hud-nav.scrolled {
  background: rgba(8, 10, 14, 0.98);
  border-bottom: 1px solid var(--color-border-volt);
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.9);
}

/* Ribbon */
.hud-ribbon {
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  padding-block: 0.35rem;
  background: rgba(20, 23, 30, 0.5);
}

.hud-ribbon__inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.08em;
  color: var(--color-text-muted);
}

.hud-ribbon__status {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.hud-ribbon__txt {
  color: var(--color-titanium);
}

.hud-ribbon__time {
  color: var(--color-volt);
  font-weight: 700;
}

/* Inner */
.hud-nav__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 64px;
}

/* Brand */
.hud-nav__brand {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
}

.hud-nav__icon {
  width: 36px;
  height: 36px;
  background: rgba(217, 255, 0, 0.08);
  border: 1px solid var(--color-border-volt);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 15px rgba(217, 255, 0, 0.2);
}

.hud-nav__titles {
  display: flex;
  flex-direction: column;
}

.hud-nav__name {
  font-family: var(--font-display);
  font-size: 1.35rem;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1;
  letter-spacing: 0.06em;
}

.hud-nav__sub {
  font-family: var(--font-mono);
  font-size: 0.55rem;
  color: var(--color-volt);
  letter-spacing: 0.2em;
  font-weight: 700;
}

/* Menu */
.hud-nav__menu {
  display: flex;
  align-items: center;
  gap: 2.25rem;
}

.hud-nav__link {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--color-text-muted);
  text-decoration: none;
  letter-spacing: 0.08em;
  transition: color 0.2s ease;
}

.hud-nav__link:hover {
  color: #FFFFFF;
}

.hud-nav__btn {
  padding: 0.65rem 1.4rem;
  font-size: 0.75rem;
}

.hud-nav__hamburger {
  display: none;
  background: transparent;
  border: none;
  width: 32px;
  height: 24px;
  flex-direction: column;
  justify-content: space-around;
  cursor: pointer;
}

.hud-nav__hamburger span {
  width: 100%;
  height: 2px;
  background: var(--color-volt);
  border-radius: 1px;
}

/* Mobile */
.hud-mobile-menu {
  position: fixed;
  top: 100px;
  inset-inline: 0;
  bottom: 0;
  background: #080A0E;
  padding: 2rem;
  z-index: 999;
}

.hud-mobile-nav {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.hud-mobile-link {
  font-family: var(--font-tech);
  font-size: 1.5rem;
  color: #FFFFFF;
  text-decoration: none;
}

.hud-mobile-link:hover { color: var(--color-volt); }

@media (max-width: 960px) {
  .hud-nav__menu, .hud-nav__btn { display: none; }
  .hud-nav__hamburger { display: flex; }
  .hud-ribbon { display: none; }
}
</style>

<script>
  const nav = document.getElementById('navbar');
  const toggle = document.getElementById('nav-toggle');
  const mobile = document.getElementById('hud-mobile');
  const timeEl = document.getElementById('live-time');

  const updateClock = () => {
    const now = new Date();
    const str = now.toLocaleTimeString('es-AR', { timeZone: 'America/Argentina/Buenos_Aires', hour12: false });
    if (timeEl) timeEl.innerText = `BA: ${str} GMT-3`;
  };
  setInterval(updateClock, 1000);
  updateClock();

  window.addEventListener('scroll', () => {
    if (window.scrollY > 30) nav?.classList.add('scrolled');
    else nav?.classList.remove('scrolled');
  }, { passive: true });

  toggle?.addEventListener('click', () => {
    const isHidden = mobile?.hasAttribute('hidden');
    if (isHidden) mobile?.removeAttribute('hidden');
    else mobile?.setAttribute('hidden', '');
  });

  mobile?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => mobile?.setAttribute('hidden', ''));
  });
</script>
