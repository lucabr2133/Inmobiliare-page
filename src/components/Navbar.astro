---
// Navbar.astro — APEX Athletic Header (No Ribbon, Clean Modern Header)
---

<header class="hud-nav" id="navbar">
  <!-- Main Navbar -->
  <div class="container hud-nav__inner">
    <!-- Brand -->
    <a href="#inicio" class="hud-nav__brand" aria-label="APEX Athletic Club">
      <div class="hud-nav__icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <path d="M13 2L3 14H12L11 22L21 10H12L13 2Z" fill="#D9FF00"/>
        </svg>
      </div>
      <div class="hud-nav__titles">
        <span class="hud-nav__name">APEX</span>
        <span class="hud-nav__sub">ATHLETIC CLUB</span>
      </div>
    </a>

    <!-- Nav Items -->
    <nav class="hud-nav__menu" aria-label="Navegación principal">
      <a href="#nosotros" class="hud-nav__link">Nosotros</a>
      <a href="#servicios" class="hud-nav__link">Disciplinas</a>
      <a href="#instalaciones" class="hud-nav__link">Instalaciones</a>
      <a href="#coaches" class="hud-nav__link">Coaches</a>
      <a href="#membresias" class="hud-nav__link">Planes</a>
      <a href="#contacto" class="hud-nav__link">Contacto</a>
    </nav>

    <!-- Action -->
    <div class="hud-nav__actions">
      <a href="#contacto" class="btn btn-volt hud-nav__btn">
        <span>VIP PASS</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <button class="hud-nav__hamburger" id="nav-toggle" aria-label="Abrir menú móvil">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="hud-mobile-menu" id="hud-mobile" hidden>
    <div class="hud-mobile-nav">
      <a href="#nosotros" class="hud-mobile-link">NOSOTROS</a>
      <a href="#servicios" class="hud-mobile-link">DISCIPLINAS</a>
      <a href="#instalaciones" class="hud-mobile-link">INSTALACIONES</a>
      <a href="#coaches" class="hud-mobile-link">COACHES</a>
      <a href="#membresias" class="hud-mobile-link">PLANES</a>
      <a href="#contacto" class="hud-mobile-link">CONTACTO</a>
      <a href="#contacto" class="btn btn-volt" style="margin-top:1.5rem;width:100%;">SOLICITAR 1-DAY PASS</a>
    </div>
  </div>
</header>

<style>
.hud-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  transition: all 0.35s ease;
  background: rgba(10, 10, 10, 0.85);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--color-border);
}

.hud-nav.scrolled {
  background: rgba(10, 10, 10, 0.98);
  border-bottom: 1px solid var(--color-border-volt);
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8);
}

/* Inner */
.hud-nav__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 70px;
}

/* Brand */
.hud-nav__brand {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
}

.hud-nav__icon {
  width: 36px;
  height: 36px;
  background: rgba(217, 255, 0, 0.08);
  border: 1px solid var(--color-border-volt);
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 15px rgba(217, 255, 0, 0.15);
}

.hud-nav__titles {
  display: flex;
  flex-direction: column;
}

.hud-nav__name {
  font-family: var(--font-display);
  font-size: 1.35rem;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1;
  letter-spacing: 0.06em;
}

.hud-nav__sub {
  font-family: var(--font-mono);
  font-size: 0.55rem;
  color: var(--color-volt);
  letter-spacing: 0.2em;
  font-weight: 700;
}

/* Menu */
.hud-nav__menu {
  display: flex;
  align-items: center;
  gap: 2.25rem;
}

.hud-nav__link {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--color-text-muted);
  text-decoration: none;
  letter-spacing: 0.08em;
  transition: color 0.2s ease;
}

.hud-nav__link:hover {
  color: #FFFFFF;
}

.hud-nav__actions {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.hud-nav__btn {
  padding: 0.65rem 1.4rem;
  font-size: 0.75rem;
}

.hud-nav__hamburger {
  display: none;
  background: transparent;
  border: none;
  width: 32px;
  height: 24px;
  flex-direction: column;
  justify-content: space-around;
  cursor: pointer;
}

.hud-nav__hamburger span {
  width: 100%;
  height: 2px;
  background: var(--color-volt);
  border-radius: 1px;
}

/* Mobile */
.hud-mobile-menu {
  position: fixed;
  top: 70px;
  inset-inline: 0;
  bottom: 0;
  background: #0A0A0A;
  padding: 2rem;
  z-index: 999;
}

.hud-mobile-nav {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.hud-mobile-link {
  font-family: var(--font-tech);
  font-size: 1.5rem;
  color: #FFFFFF;
  text-decoration: none;
}

.hud-mobile-link:hover { color: var(--color-volt); }

@media (max-width: 960px) {
  .hud-nav__menu, .hud-nav__btn { display: none; }
  .hud-nav__hamburger { display: flex; }
}
</style>

<script>
  const nav = document.getElementById('navbar');
  const toggle = document.getElementById('nav-toggle');
  const mobile = document.getElementById('hud-mobile');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 30) nav?.classList.add('scrolled');
    else nav?.classList.remove('scrolled');
  }, { passive: true });

  toggle?.addEventListener('click', () => {
    const isHidden = mobile?.hasAttribute('hidden');
    if (isHidden) mobile?.removeAttribute('hidden');
    else mobile?.setAttribute('hidden', '');
  });

  mobile?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => mobile?.setAttribute('hidden', ''));
  });
</script>
