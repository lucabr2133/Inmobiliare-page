---
---

<div class="preloader" id="preloader">
  <div class="preloader__inner">
    <span class="preloader__brand">INMOBILIARE</span>
    <div class="preloader__bar-wrap">
      <div class="preloader__bar" id="preloader-bar"></div>
    </div>
  </div>
</div>

<style>
.preloader {
  position: fixed;
  inset: 0;
  z-index: 10000;
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.preloader__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
  width: 180px;
}

.preloader__brand {
  font-family: var(--font-display);
  font-size: 1.6rem;
  font-weight: 400;
  color: var(--color-gold);
  letter-spacing: 0.25em;
}

.preloader__bar-wrap {
  width: 100%;
  height: 1px;
  background: var(--color-border);
  overflow: hidden;
}

.preloader__bar {
  height: 100%;
  width: 0%;
  background: var(--color-gold);
}
</style>

<script>
  import gsap from 'gsap';

  const preloader = document.getElementById('preloader');
  const bar = document.getElementById('preloader-bar');

  if (preloader && bar) {
    gsap.timeline({
      onComplete: () => {
        // @ts-ignore
        window.isPreloaderRevealed = true;
        window.dispatchEvent(new CustomEvent('preloaderReveal'));
        gsap.to(preloader, {
          opacity: 0, duration: 0.5, ease: 'power2.inOut',
          onComplete: () => { preloader.style.display = 'none'; }
        });
      }
    }).to(bar, { width: '100%', duration: 1, ease: 'power2.inOut' });
  }
</script>
