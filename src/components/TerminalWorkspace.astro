<script>
  // CCTV Zone Switcher
  const channelBtns = document.querySelectorAll('.channel-btn');
  const feedPanes = document.querySelectorAll('.cctv-feed-pane');

  channelBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const zone = btn.getAttribute('data-zone');
      channelBtns.forEach(b => b.classList.remove('active'));
      feedPanes.forEach(f => f.classList.remove('active'));

      btn.classList.add('active');
      document.getElementById('feed-' + zone)?.classList.add('active');
    });
  });

  // Protocol Switcher
  const protoCards = document.querySelectorAll('.proto-card');
  const protoViews = document.querySelectorAll('.proto-view-card');

  protoCards.forEach(card => {
    card.addEventListener('click', () => {
      const proto = card.getAttribute('data-proto');
      protoCards.forEach(c => c.classList.remove('active'));
      protoViews.forEach(v => v.classList.remove('active'));

      card.classList.add('active');
      document.getElementById('view-' + proto)?.classList.add('active');
    });
  });

  // Live Pass Preview
  const nameInput = document.getElementById('os-name');
  const locSelect = document.getElementById('os-loc');
  const keyHolder = document.getElementById('key-holder-preview');
  const keyLoc = document.getElementById('key-loc-preview');
  const passForm = document.getElementById('cockpit-pass-form');
  const issuedMsg = document.getElementById('os-issued-msg');

  nameInput?.addEventListener('input', () => {
    if (keyHolder) keyHolder.innerText = nameInput.value.trim() ? nameInput.value.toUpperCase() : 'ATLETA TITULAR';
  });

  locSelect?.addEventListener('change', () => {
    if (keyLoc) keyLoc.innerText = 'Sede ' + locSelect.value;
  });

  passForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    issuedMsg?.removeAttribute('hidden');
  });
</script>
