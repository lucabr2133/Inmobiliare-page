---

<div class="cockpit-workspace">
  <!-- PANE 1: ZONE CCTV MONITOR & BLUEPRINT -->
  <section class="os-pane" id="pane-zones">
    <div class="os-pane-header">
      <div class="pane-title-group">
        <span class="os-lamp"></span>
        <h2 class="os-pane-title">ZONE CCTV MONITOR // FACILITY BLUEPRINT</h2>
      </div>
      <div class="pane-telemetry-pill">
        <span>6/6 CAMS ACTIVE · PALERMO SOHO & RECOLETA</span>
      </div>
    </div>

    <div class="cctv-grid-layout">
      <!-- Left: Channel Selector Bar -->
      <div class="cctv-channels" role="tablist">
        {zones.map((z, i) => (
          <button class={`channel-btn ${i === 0 ? 'active' : ''}`} data-zone={z.id}>
            <div class="ch-top">
              <span class="ch-code">{z.code}</span>
              <span class="ch-temp">{z.temp}</span>
            </div>
            <span class="ch-name">{z.name}</span>
            <div class="ch-meta">
              <span>{z.status}</span>
            </div>
          </button>
        ))}
      </div>

      <!-- Right: Main Tactical Feed Monitor -->
      <div class="cctv-main-monitor">
        {zones.map((z, i) => (
          <div class={`cctv-feed-pane ${i === 0 ? 'active' : ''}`} id={`feed-${z.id}`}>
            <div class="cctv-screen-wrap">
              <img src={z.image} alt={z.name} class="cctv-feed-img" />
              <div class="cctv-scanlines"></div>
              <div class="cctv-hud-overlay">
                <div class="cctv-hud-top">
                  <span class="cctv-rec-badge"><span class="os-lamp"></span> LIVE STREAM // {z.code}</span>
                  <span class="cctv-tele-stat">TEMP: {z.temp} | LOAD: {z.load} | NOISE: {z.noise}</span>
                </div>
                <div class="cctv-crosshair"></div>
              </div>
            </div>

            <!-- Feed Intel Details -->
            <div class="cctv-intel-bar">
              <div class="intel-text">
                <h3 class="intel-zone-name">{z.name}</h3>
                <p class="intel-zone-desc">{z.desc}</p>
                <div class="intel-specs-chips">
                  {z.specs.map(s => <span class="spec-chip">✓ {s}</span>)}
                </div>
              </div>
              <div class="intel-action">
                <button class="os-btn os-btn-volt" onclick="document.querySelector('[data-mode=pass]')?.click()">
                  <span>AGENDAR EN ESTA ZONA</span>
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PANE 2: PERFORMANCE PROTOCOLS & BIOMECHANIC ENGINE -->
  <section class="os-pane" id="pane-protocols">
    <div class="os-pane-header">
      <div class="pane-title-group">
        <span class="os-lamp"></span>
        <h2 class="os-pane-title">BIOMECHANIC ENGINE // TRAINING PROTOCOLS</h2>
      </div>
      <div class="pane-telemetry-pill">
        <span>NEUROMUSCULAR RECRUITMENT SENSORS</span>
      </div>
    </div>

    <div class="protocols-matrix-layout">
      <!-- Left: Protocol List Selector -->
      <div class="proto-list">
        {protocols.map((p, i) => (
          <div class={`proto-card ${i === 0 ? 'active' : ''}`} data-proto={p.id}>
            <div class="proto-card-top">
              <span class="proto-code">{p.code}</span>
              <span class="proto-burn">🔥 {p.burn}</span>
            </div>
            <h3 class="proto-title">{p.name}</h3>
            <p class="proto-focus">{p.focus}</p>
            <div class="proto-bars">
              <div class="p-bar-label">
                <span>INTENSIDAD: {p.intensity}</span>
                <span>SISTEMA: {p.energy}</span>
              </div>
              <div class="p-bar-track">
                <div class="p-bar-fill" style={`width: ${p.intensity};`}></div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Right: Live Biomechanic Telemetry Card -->
      <div class="proto-display-console">
        {protocols.map((p, i) => (
          <div class={`proto-view-card ${i === 0 ? 'active' : ''}`} id={`view-${p.id}`}>
            <div class="proto-view-media">
              <img src={p.image} alt={p.name} class="proto-view-img" />
              <div class="proto-view-overlay"></div>
              <div class="proto-view-telemetry">
                <span class="os-lamp"></span>
                <span>COACH ENCARGADO: {p.coach}</span>
              </div>
            </div>
            <div class="proto-view-intel">
              <div class="proto-grid-stats">
                <div class="stat-cell">
                  <span class="cell-lbl">GASTO CALÓRICO</span>
                  <span class="cell-val">{p.burn}</span>
                </div>
                <div class="stat-cell">
                  <span class="cell-lbl">INTENSIDAD CARDÍACA</span>
                  <span class="cell-val">{p.intensity}</span>
                </div>
                <div class="stat-cell">
                  <span class="cell-lbl">SISTEMA ENERGÉTICO</span>
                  <span class="cell-val">{p.energy}</span>
                </div>
              </div>
              <button class="os-btn os-btn-volt" style="width:100%;margin-top:1rem;" onclick="document.querySelector('[data-mode=pass]')?.click()">
                <span>RESERVAR SESIÓN EN ESTE PROTOCOLO</span>
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PANE 3: LIVE SATELLITE CLASS RADAR & TIMETABLE -->
  <section class="os-pane" id="pane-radar">
    <div class="os-pane-header">
      <div class="pane-title-group">
        <span class="os-lamp"></span>
        <h2 class="os-pane-title">LIVE CLASS RADAR // WEEKLY TIMETABLE</h2>
      </div>
      <div class="pane-telemetry-pill">
        <span>MAX 8 ATLETAS POR TURNO · AFORO CONTROLADO</span>
      </div>
    </div>

    <div class="radar-terminal-table">
      <div class="radar-header-row">
        <span>HORARIO</span>
        <span>DISCIPLINA // PROTOCOLO</span>
        <span>HEAD COACH</span>
        <span>INTENSIDAD</span>
        <span>CUPOS DISPONIBLES</span>
        <span>ACCIÓN</span>
      </div>

      <div class="radar-rows-container">
        <div class="radar-row">
          <span class="r-time">⚡ 06:30 - 07:30</span>
          <span class="r-name">Hyrox Engine Dawn Simulation</span>
          <span class="r-coach">Marcos Valdés</span>
          <span class="r-intensity">95% Láctico</span>
          <span class="r-spots r-spots--avail">3 Cupos</span>
          <button class="os-btn os-btn-volt r-btn" onclick="document.querySelector('[data-mode=pass]')?.click()">RESERVAR</button>
        </div>
        <div class="radar-row">
          <span class="r-time">⚡ 08:00 - 09:15</span>
          <span class="r-name">Olympic Snatch Mastery & Video Review</span>
          <span class="r-coach">Valentina Rossi</span>
          <span class="r-intensity">90% Técnica</span>
          <span class="r-spots r-spots--avail">2 Cupos</span>
          <button class="os-btn os-btn-volt r-btn" onclick="document.querySelector('[data-mode=pass]')?.click()">RESERVAR</button>
        </div>
        <div class="radar-row">
          <span class="r-time">⚡ 12:30 - 13:25</span>
          <span class="r-name">Combat Boxing Striking Aquabag</span>
          <span class="r-coach">Mateo Silva</span>
          <span class="r-intensity">88% Combate</span>
          <span class="r-spots r-spots--avail">4 Cupos</span>
          <button class="os-btn os-btn-volt r-btn" onclick="document.querySelector('[data-mode=pass]')?.click()">RESERVAR</button>
        </div>
        <div class="radar-row">
          <span class="r-time">⚡ 18:00 - 19:00</span>
          <span class="r-name">Hyrox Race Comp Sleds & SkiErg</span>
          <span class="r-coach">Marcos Valdés</span>
          <span class="r-intensity">98% Extrema</span>
          <span class="r-spots r-spots--low">1 Cupo</span>
          <button class="os-btn os-btn-volt r-btn" onclick="document.querySelector('[data-mode=pass]')?.click()">RESERVAR</button>
        </div>
        <div class="radar-row">
          <span class="r-time">⚡ 19:30 - 20:25</span>
          <span class="r-name">Athletic Reformer Spine Decompress</span>
          <span class="r-coach">Dra. Camila Duarte</span>
          <span class="r-intensity">75% Core</span>
          <span class="r-spots r-spots--full">Completo</span>
          <button class="os-btn os-btn-ghost r-btn" disabled>LISTA ESPERA</button>
        </div>
      </div>
    </div>
  </section>

  <!-- PANE 4: OLYMPIC MASTER DOSSIER & HEAD COACHES -->
  <section class="os-pane" id="pane-coaches">
    <div class="os-pane-header">
      <div class="pane-title-group">
        <span class="os-lamp"></span>
        <h2 class="os-pane-title">OLYMPIC MASTER DOSSIER // HEAD COACHES</h2>
      </div>
      <div class="pane-telemetry-pill">
        <span>BIOMECHANIC SPECIALISTS & PRO ATHLETES</span>
      </div>
    </div>

    <div class="dossier-grid">
      {coaches.map(c => (
        <div class="dossier-card">
          <div class="dossier-photo-wrap">
            <img src={c.image} alt={c.name} class="dossier-photo" />
            <div class="dossier-overlay"></div>
            <div class="dossier-tag">{c.callsign}</div>
          </div>
          <div class="dossier-info">
            <span class="dossier-role">{c.role}</span>
            <h3 class="dossier-name">{c.name}</h3>
            <div class="dossier-pr-box">
              <span>{c.prs}</span>
            </div>
            <p class="dossier-bio">{c.bio}</p>
            <button class="os-btn os-btn-ghost dossier-btn" onclick="document.querySelector('[data-mode=pass]')?.click()">
              <span>SOLICITAR COACHING 1-ON-1</span>
            </button>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- PANE 5: CELLULAR RECOVERY CHAMBER & CRYO SPA -->
  <section class="os-pane" id="pane-biohack">
    <div class="os-pane-header">
      <div class="pane-title-group">
        <span class="os-lamp"></span>
        <h2 class="os-pane-title">CELLULAR RECOVERY CHAMBER // BIOHACK LAB</h2>
      </div>
      <div class="pane-telemetry-pill">
        <span>-110°C CRYO · INFRARED SAUNA · 3°C COLD PLUNGE</span>
      </div>
    </div>

    <div class="recovery-console-grid">
      <div class="rec-console-card">
        <div class="rec-temp-val">-110°C</div>
        <h3 class="rec-unit-title">Whole-Body Cryo Chamber</h3>
        <p class="rec-unit-desc">3 minutos de exposición a nitrógeno seco. Provoca vasoconstricción masiva, eliminación de citoquinas inflamatorias y oleada de dopamina (+250%).</p>
        <div class="rec-metrics-pill">
          <span>-68% INFLAMACIÓN</span>
          <span>+250% DOPAMINA</span>
        </div>
      </div>
      <div class="rec-console-card">
        <div class="rec-temp-val">+85°C</div>
        <h3 class="rec-unit-title">Full-Spectrum Infrared Sauna</h3>
        <p class="rec-unit-desc">Ondas infrarrojas profundas (4 cm de penetración celular). Estimula biogénesis mitocondrial, eliminación de toxinas y vasodilatación profunda.</p>
        <div class="rec-metrics-pill">
          <span>+42% SUEÑO PROFUNDO</span>
          <span>+85% CIRCULACIÓN</span>
        </div>
      </div>
      <div class="rec-console-card">
        <div class="rec-temp-val">3°C</div>
        <h3 class="rec-unit-title">Ice Bath Regeneration</h3>
        <p class="rec-unit-desc">Piletas de agua helada con flujo laminar y filtración por ozono. Acelera el aclaramiento de lactato y activa el sistema nervioso parasimpático.</p>
        <div class="rec-metrics-pill">
          <span>+35% BALANCE HRV</span>
          <span>-50% DOLOR DOMS</span>
        </div>
      </div>
    </div>
  </section>

  <!-- PANE 6: DIGITAL SMART ACCESS PASS ISSUANCE TERMINAL -->
  <section class="os-pane" id="pane-pass">
    <div class="os-pane-header">
      <div class="pane-title-group">
        <span class="os-lamp"></span>
        <h2 class="os-pane-title">DIGITAL ACCESS TERMINAL // 1-DAY VIP PASS</h2>
      </div>
      <div class="pane-telemetry-pill">
        <span>EMISIÓN INMEDIATA DE CREDENCIAL BIOMÉTRICA</span>
      </div>
    </div>

    <div class="access-terminal-grid" id="access-terminal">
      <div class="access-form-console">
        <form class="terminal-form" id="cockpit-pass-form">
          <div class="os-form-row">
            <div class="os-field">
              <label>NOMBRE COMPLETO *</label>
              <input type="text" id="os-name" required placeholder="Santiago Albarracín" />
            </div>
            <div class="os-field">
              <label>WHATSAPP / MÓVIL *</label>
              <input type="tel" id="os-phone" required placeholder="+54 9 11 ..." />
            </div>
          </div>

          <div class="os-form-row">
            <div class="os-field">
              <label>SEDE DE PREFERENCIA *</label>
              <select id="os-loc" required>
                <option value="Palermo Soho">Palermo Soho — Gorriti 5120</option>
                <option value="Recoleta">Recoleta — Av. Alvear 1890</option>
              </select>
            </div>
