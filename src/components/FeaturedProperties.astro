---
// FeaturedProperties.astro → APEX Facilities Showcase (Horizontal Pinned Scroll)
const facilities = [
  {
    id: 1, number: '01',
    badge: 'Fuerza & Halterofilia', badgeType: 'volt',
    title: 'The Iron Temple',
    spec1: 'Eleiko Plates · 15.000 kg', spec2: 'Hammer Strength Racks', spec3: 'Mancuernas hasta 70kg',
    description: 'Plataformas olímpicas de tarima de roble y caucho de alta absorción. Barra olímpica calibrada IWF y zona libre de tiza sin restricciones.',
    amenity: 'Setup: 8 Plataformas IWF + 12 Power Racks',
    image: 'https://images.pexels.com/photos/1552252/pexels-photo-1552252.jpeg?auto=compress&cs=tinysrgb&w=800&h=500&dpr=1',
    alt: 'Zona de levantamiento olímpico The Iron Temple con barras Eleiko'
  },
  {
    id: 2, number: '02',
    badge: 'Biomecánica 3D', badgeType: 'cyan',
    title: 'Hypertrophy Lab',
    spec1: 'Prime Fitness SmartCam', spec2: 'Arsenal Strength Reloaded', spec3: 'Pendulum Squat Pro',
    description: 'Maquinaria de aislamiento con curvas de resistencia adaptativas. Máxima activación muscular con estrés articular mínimo.',
    amenity: 'Setup: Biomecánica guiada de precisión',
    image: 'https://images.pexels.com/photos/1954524/pexels-photo-1954524.jpeg?auto=compress&cs=tinysrgb&w=800&h=500&dpr=1',
    alt: 'Maquinaria de aislamiento biomecánico Hypertrophy Lab'
  },
  {
    id: 3, number: '03',
    badge: 'Deportes de Contacto', badgeType: 'flame',
    title: 'The Octagon Arena',
    spec1: 'Ring Oficial de Boxeo', spec2: 'Bolsas de Agua Aquabag', spec3: 'Tatami Olímpico 200m²',
    description: 'Espacio para boxeo, kickboxing y artes marciales mixtas guiado por entrenadores de combate profesional y sparrings controlados.',
    amenity: 'Setup: Ring profesional + 14 bolsas pesadas',
    image: 'https://images.pexels.com/photos/4754148/pexels-photo-4754148.jpeg?auto=compress&cs=tinysrgb&w=800&h=500&dpr=1',
    alt: 'Ring de boxeo y zona de combate The Octagon Arena'
  },
  {
    id: 4, number: '04',
    badge: 'Metabólico & Hyrox', badgeType: 'volt',
    title: 'Metabolic Turf 40M',
    spec1: 'Pista de Trineo 40 metros', spec2: 'SkiErg & Concept2 Rowers', spec3: 'Assault AirBikes',
    description: 'Pista de césped sintético de alta fricción para empuje de trineos Prowler, estaciones Hyrox oficiales y acondicionamiento cardiovascular anaeróbico.',
    amenity: 'Setup: Centro Oficial Hyrox Training Club',
    image: 'https://images.pexels.com/photos/3823039/pexels-photo-3823039.jpeg?auto=compress&cs=tinysrgb&w=800&h=500&dpr=1',
    alt: 'Pista de trineo y zona de entrenamiento metabólico Hyrox Turf'
  },
  {
    id: 5, number: '05',
    badge: 'Biohacking & Cryo', badgeType: 'cyan',
    title: 'Recovery Sanctuary',
    spec1: 'Criocabina -110°C', spec2: 'Sauna Infrarrojo Cedro', spec3: 'Ice Baths 3°C Plunge',
    description: 'Laboratorio de recuperación celular rápida: crioterapia de cuerpo entero, botas de compresión Normatec, terapia de luz roja y saunas finlandeses.',
    amenity: 'Setup: Biohacking celular de vanguardia',
    image: 'https://images.pexels.com/photos/3757942/pexels-photo-3757942.jpeg?auto=compress&cs=tinysrgb&w=800&h=500&dpr=1',
    alt: 'Zona de biohacking, crioterapia y recuperación celular'
  },
  {
    id: 6, number: '06',
    badge: 'Control & Movilidad', badgeType: 'titanium',
    title: 'Reformer & Yoga Shala',
    spec1: 'Allegro 2 Reformers', spec2: 'Iluminación Circadiana', spec3: 'Sound Healing & Breathwork',
    description: 'Estudio de Pilates Reformer atlético para estabilidad del core y prevención de lesiones, junto a sesiones de respiración guiada y movilidad articular.',
    amenity: 'Setup: 12 Camas Reformer Balanced Body',
    image: 'https://images.pexels.com/photos/4056723/pexels-photo-4056723.jpeg?auto=compress&cs=tinysrgb&w=800&h=500&dpr=1',
    alt: 'Estudio de Pilates Reformer y Yoga Shala en APEX'
  },
];
---

<section class="featured-props" id="instalaciones" aria-labelledby="featured-heading">
  <div class="featured-props__header container reveal">
    <span class="eyebrow">INSTALACIONES DE NIVEL OLÍMPICO</span>
    <span class="volt-line"></span>
    <h2 class="display-heading section-heading" id="featured-heading">
      Zonas de <span class="highlight-text">Alto Rendimiento</span>
    </h2>
    <p class="section-desc">
      2.500 m² diseñados con el estándar biomecánico más exigente del mundo. Cada espacio responde a un objetivo de rendimiento y recuperación sin concesiones.
    </p>
  </div>

  <div class="hscroll-section" id="hscroll-section">
    <div class="hscroll-track" id="hscroll-track" role="list" aria-label="Zonas del Club">
      {facilities.map((item) => (
        <article class={`prop-card prop-card--${item.badgeType}`} role="listitem" aria-label={item.title}>
          <a href="#contacto" class="prop-card__link">
            <div class="prop-card__img-wrap">
              <img src={item.image} alt={item.alt} class="prop-card__img" loading="lazy" width="800" height="500" />
              <div class="card-tag-row">
                <span class={`prop-badge prop-badge--${item.badgeType}`}>{item.badge}</span>
                <span class="card-num">ZONA {item.number}</span>
              </div>
              <div class="prop-card__overlay">
                <span>Agendar Sesión en Zona</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </div>
            </div>
            <div class="prop-card__body">
              <div class="prop-card__meta">
                <span class="prop-meta-type">{item.spec1}</span>
              </div>
              <h3 class="prop-card__title">{item.title}</h3>
              <p class="prop-card__notes">{item.description}</p>
              <div class="prop-card__amenity">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                <span>{item.amenity}</span>
              </div>
              <div class="prop-card__specs">
                <span class="prop-spec">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                  {item.spec2}
                </span>
                <span class="prop-spec">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                  {item.spec3}
                </span>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>
    <div class="hscroll-progress" aria-hidden="true">
      <div class="hscroll-progress__bar" id="hscroll-bar"></div>
    </div>
  </div>

  <div class="featured-cta container reveal">
    <a href="#contacto" class="btn btn-volt">
      <span>Reservar Tour Privado con Head Coach</span>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  </div>
</section>

<style>
.featured-props {
  background: var(--color-bg);
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-top: clamp(2rem, 4vh, 3.5rem);
  padding-bottom: clamp(2rem, 4vh, 3.5rem);
  overflow: hidden;
  position: relative;
}

.featured-props__header {
  max-width: 640px;
  margin-bottom: clamp(1rem, 2vh, 1.75rem);
}

.section-heading {
  font-size: clamp(1.9rem, 3.5vw, 2.9rem);
  color: #FFFFFF;
  margin-bottom: 0.4rem;
}

.highlight-text {
  background: var(--grad-volt);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.section-desc {
  color: var(--color-cream-muted);
  font-size: 0.88rem;
  line-height: 1.5;
  font-weight: 400;
}

/* ─── Horizontal Scroll ─────────────────────────────────── */
.hscroll-section {
  position: relative;
  margin-bottom: clamp(0.5rem, 1vh, 1rem);
  padding-block: 0.5rem;
}

.hscroll-track {
  display: flex;
  align-items: stretch;
  gap: 1.5rem;
  padding-left: var(--container-pad);
  padding-right: var(--container-pad);
  width: max-content;
  will-change: transform;
}

.hscroll-progress {
  height: 3px;
  background: rgba(255, 255, 255, 0.08);
  margin: 1rem var(--container-pad) 0;
  position: relative;
  border-radius: 9999px;
  overflow: hidden;
}

.hscroll-progress__bar {
  position: absolute;
  inset: 0;
  background: var(--grad-volt);
  transform-origin: left;
  transform: scaleX(0);
  will-change: transform;
  box-shadow: 0 0 16px rgba(204, 255, 0, 0.9);
}

/* Card */
.prop-card {
  flex: 0 0 clamp(310px, 23vw, 350px);
  background: var(--color-bg-card);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: var(--radius-md);
  overflow: hidden;
  transition: transform 0.35s cubic-bezier(0.16,1,0.3,1), border-color 0.35s ease, box-shadow 0.35s ease;
  will-change: transform;
  position: relative;
}

.prop-card:hover {
  transform: translateY(-8px);
}

/* Multi-Color Card Styles */
.prop-card--volt:hover {
  border-color: var(--color-volt);
  box-shadow: 0 20px 50px rgba(0,0,0,0.85), 0 0 30px rgba(204, 255, 0, 0.35);
}
.prop-card--cyan:hover {
  border-color: var(--color-cyan);
  box-shadow: 0 20px 50px rgba(0,0,0,0.85), 0 0 30px rgba(0, 240, 255, 0.35);
}
.prop-card--flame:hover {
  border-color: var(--color-flame);
  box-shadow: 0 20px 50px rgba(0,0,0,0.85), 0 0 30px rgba(255, 85, 0, 0.35);
}
.prop-card--titanium:hover {
  border-color: #FFFFFF;
  box-shadow: 0 20px 50px rgba(0,0,0,0.85), 0 0 30px rgba(255, 255, 255, 0.3);
}

.prop-card__link { display: flex; flex-direction: column; height: 100%; }

/* Image */
.prop-card__img-wrap {
  position: relative;
  overflow: hidden;
  aspect-ratio: 16 / 10;
  background: #080C14;
}

.prop-card__img {
  width: 100%; height: 100%;
  object-fit: cover;
  filter: brightness(0.85) contrast(1.15) saturate(1.05);
  transition: transform 0.7s cubic-bezier(0.16,1,0.3,1);
}

.prop-card:hover .prop-card__img {
  transform: scale(1.08);
}

/* Tag row */
.card-tag-row {
  position: absolute;
  top: 0.75rem;
  left: 0.75rem;
  right: 0.75rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-num {
  font-family: var(--font-heading);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: #FFFFFF;
  background: rgba(8, 12, 20, 0.88);
  padding: 0.25rem 0.6rem;
  border: 1px solid rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8px);
  border-radius: var(--radius-sm);
}

/* Badges */
.prop-badge {
  font-size: 0.6rem;
  font-weight: 800;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  padding: 0.3rem 0.75rem;
  border-radius: var(--radius-pill);
}

.prop-badge--volt     { background: var(--color-volt); color: #080C14; }
.prop-badge--cyan     { background: var(--color-cyan); color: #080C14; }
.prop-badge--flame    { background: var(--color-flame); color: #FFFFFF; }
.prop-badge--titanium { background: #FFFFFF; color: #080C14; }

/* Overlay */
.prop-card__overlay {
  position: absolute;
  inset: 0;
  background: rgba(8, 12, 20, 0.8);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  color: #FFFFFF;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.prop-card:hover .prop-card__overlay { opacity: 1; }

/* Body */
.prop-card__body {
  padding: 1.15rem 1.35rem;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.prop-card__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.35rem;
}

.prop-meta-type {
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-volt);
}

.prop-card__title {
  font-family: var(--font-heading);
  font-size: 1.25rem;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 0.35rem;
  line-height: 1.2;
  text-transform: uppercase;
}

.prop-card__notes {
  font-size: 0.8rem;
  color: var(--color-cream-muted);
  line-height: 1.5;
  margin-bottom: 0.7rem;
  font-weight: 400;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.prop-card__amenity {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.68rem;
  font-weight: 600;
  color: #F8FAFC;
  background: rgba(255, 255, 255, 0.06);
  padding: 0.35rem 0.65rem;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: var(--radius-sm);
  margin-bottom: 0.7rem;
}

.prop-card__amenity svg { flex-shrink: 0; color: var(--color-volt); }

.prop-card__specs {
  display: flex;
  gap: 0.85rem;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  padding-top: 0.65rem;
  margin-top: auto;
}

.prop-spec {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.68rem;
  color: var(--color-cream-muted);
  font-weight: 500;
}

.prop-spec svg { color: var(--color-cyan); flex-shrink: 0; }

.featured-cta { text-align: center; margin-top: clamp(0.75rem, 1.5vh, 1.25rem); }
.featured-cta .btn { padding: 0.75rem 1.8rem; font-size: 0.75rem; }

@media (max-width: 768px) {
  .featured-props { min-height: auto; padding-top: 4rem; padding-bottom: 4rem; }
  .hscroll-track { display: grid; grid-template-columns: 1fr; width: 100%; padding-inline: var(--container-pad); gap: 1.5rem; }
  .prop-card { flex: none; width: 100%; }
  .hscroll-progress { display: none; }
}
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const containerSection = document.getElementById('instalaciones');
  const section = document.getElementById('hscroll-section');
  const track = document.getElementById('hscroll-track');
  const bar = document.getElementById('hscroll-bar');

  if (containerSection && section && track && window.innerWidth > 768) {
    const getAmt = () => {
      return Math.max(0, track.scrollWidth - window.innerWidth + 60);
    };

    // 1. Horizontal track pin and scrub
    gsap.to(track, {
      x: () => -getAmt(),
      ease: 'none',
      scrollTrigger: {
        trigger: containerSection,
        pin: true,
        start: 'top top',
        end: () => `+=${getAmt()}`,
        scrub: 0.8,
        invalidateOnRefresh: true,
        onUpdate: (self) => {
          if (bar) gsap.set(bar, { scaleX: self.progress });
        }
      }
    });

    // 2. Initial card entrance animation
    const cards = track.querySelectorAll<HTMLElement>('.prop-card');
    gsap.fromTo(cards,
      { opacity: 0, y: 35 },
      {
        opacity: 1,
        y: 0,
        duration: 0.85,
        stagger: 0.08,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: section,
          start: 'top 85%',
          toggleActions: 'play none none none',
          once: true,
        },
        onComplete: () => {
          gsap.set(cards, { clearProps: 'transform' });
        }
      }
    );

    // Refresh calculations once full page resources finish settling
    window.addEventListener('load', () => {
      ScrollTrigger.refresh();
    });
  }
</script>

