---
// FeaturedProperties.astro → Multi-Color Featured Menu Collection
const menuItems = [
  {
    id: 1, number: '01',
    badge: 'Signature', badgeType: 'violet',
    accentColor: '#8B5CF6',
    title: 'Wagyu Melanosporum',
    cut: 'Wagyu A5 · 220g', bread: 'Brioche Papa 48h', cheese: 'Morbier Francés',
    notes: 'Emulsión de trufa negra Melanosporum fresca, chalotas glaseadas al Pedro Ximénez y queso Morbier fundido al hierro.',
    pairing: 'Maridaje: Negroni ahumado con quebracho',
    price: '$19.500',
    image: 'https://images.pexels.com/photos/1639557/pexels-photo-1639557.jpeg?auto=compress&cs=tinysrgb&w=800&h=600&dpr=1',
    alt: 'Hamburguesa Wagyu Melanosporum con trufa negra y queso fundido'
  },
  {
    id: 2, number: '02',
    badge: 'Edición Fuego', badgeType: 'flame',
    accentColor: '#FF5722',
    title: 'Smoked Bone Marrow',
    cut: 'Dry Aged 45d · Doble', bread: 'Brioche Dorado', cheese: 'Cheddar 18 meses',
    notes: 'Tuétano vacuno asado a la brasa, cheddar inglés curado, bacon crocante de manzano y reducción de bourbon.',
    pairing: 'Maridaje: Old Fashioned fat-washed de panceta',
    price: '$18.200',
    image: 'https://images.pexels.com/photos/3616956/pexels-photo-3616956.jpeg?auto=compress&cs=tinysrgb&w=800&h=600&dpr=1',
    alt: 'Hamburguesa Smoked Bone Marrow con tuétano y cheddar'
  },
  {
    id: 3, number: '03',
    badge: 'Haute Vegan', badgeType: 'mint',
    accentColor: '#06D6A0',
    title: 'Portobello Miso Dulce',
    cut: 'Portobello Salvaje', bread: 'Masa Madre Semillas', cheese: 'Cabra Afinado',
    notes: 'Sombrero gigante de Portobello glaseado con miso blanco dulce, queso de cabra flambeado y alioli de ajo negro.',
    pairing: 'Maridaje: Pinot Noir de la Patagonia',
    price: '$15.800',
    image: 'https://images.pexels.com/photos/1251198/pexels-photo-1251198.jpeg?auto=compress&cs=tinysrgb&w=800&h=600&dpr=1',
    alt: 'Hamburguesa vegetariana de portobello glaseado al miso'
  },
  {
    id: 4, number: '04',
    badge: 'Ícono Dorado', badgeType: 'saffron',
    accentColor: '#FFB703',
    title: 'Doble Royale au Poivre',
    cut: 'Doble Wagyu Smash', bread: 'Brioche Manteca', cheese: 'Raclette Suizo',
    notes: 'Costra crujiente de pimienta verde de Madagascar, cuádruple raclette fundida en mesa y salsa cognac.',
    pairing: 'Maridaje: Stout Imperial de guarda',
    price: '$18.900',
    image: 'https://images.pexels.com/photos/2983101/pexels-photo-2983101.jpeg?auto=compress&cs=tinysrgb&w=800&h=600&dpr=1',
    alt: 'Hamburguesa Doble Royale au Poivre con queso raclette'
  },
  {
    id: 5, number: '05',
    badge: 'Volaille Crispy', badgeType: 'cobalt',
    accentColor: '#3B82F6',
    title: 'Crispy Karaage & Yuzu',
    cut: 'Pollo de Campo · Panko', bread: 'Brioche Sésamo', cheese: 'Coleslaw Hinojo',
    notes: 'Suprema de pollo marinada 24h en suero y jengibre, frita en panko japonés y mayonesa cítrica de yuzu.',
    pairing: 'Maridaje: Highball de Whisky Japonés & Yuzu',
    price: '$16.400',
    image: 'https://images.pexels.com/photos/2673353/pexels-photo-2673353.jpeg?auto=compress&cs=tinysrgb&w=800&h=600&dpr=1',
    alt: 'Hamburguesa de pollo Karaage con salsa yuzu'
  },
  {
    id: 6, number: '06',
    badge: 'Herencia Criolla', badgeType: 'ruby',
    accentColor: '#EF233C',
    title: 'Provoleta & Chimi Negro',
    cut: 'Ojo de Bife · 250g', bread: 'Focaccia Brioche', cheese: 'Provoleta Hilada',
    notes: 'Corte grueso a las brasas de quebracho blanco, provoleta crocante de masa hilada y chimichurri fermentado.',
    pairing: 'Maridaje: Malbec de Altura de Gualtallary',
    price: '$17.800',
    image: 'https://images.pexels.com/photos/1600727/pexels-photo-1600727.jpeg?auto=compress&cs=tinysrgb&w=800&h=600&dpr=1',
    alt: 'Hamburguesa con provoleta crocante y chimichurri negro'
  },
];
---

<section class="featured-props" id="propiedades" aria-labelledby="featured-heading">
  <div class="featured-props__header container reveal">
    <span class="eyebrow">LA CARTA SIGNATURE</span>
    <span class="gold-line"></span>
    <h2 class="display-heading section-heading" id="featured-heading">
      Creaciones de <span class="highlight-text">Autor</span>
    </h2>
    <p class="section-desc">
      Seis creaciones concebidas con el rigor de la alta gastronomía. Cada hamburguesa posee un perfil organoléptico único con maridajes diseñados a medida.
    </p>
  </div>

  <div class="hscroll-section" id="hscroll-section">
    <div class="hscroll-track" id="hscroll-track" role="list" aria-label="Colección Signature">
      {menuItems.map((item) => (
        <article class={`prop-card prop-card--${item.badgeType}`} role="listitem" aria-label={item.title}>
          <a href="#contacto" class="prop-card__link">
            <div class="prop-card__img-wrap">
              <img src={item.image} alt={item.alt} class="prop-card__img" loading="lazy" width="800" height="600" />
              <div class="card-tag-row">
                <span class={`prop-badge prop-badge--${item.badgeType}`}>{item.badge}</span>
                <span class="card-num">№ {item.number}</span>
              </div>
              <div class="prop-card__overlay">
                <span>Degustar en Sala</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </div>
            </div>
            <div class="prop-card__body">
              <div class="prop-card__meta">
                <span class="prop-meta-type">{item.cut}</span>
                <span class="prop-card__price">{item.price}</span>
              </div>
              <h3 class="prop-card__title">{item.title}</h3>
              <p class="prop-card__notes">{item.notes}</p>
              <div class="prop-card__pairing">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 22h8M12 15v7M17 2l2 6H5l2-6h10z"/><path d="M5 8c0 4.418 3.134 8 7 8s7-3.582 7-8H5z"/></svg>
                <span>{item.pairing}</span>
              </div>
              <div class="prop-card__specs">
                <span class="prop-spec">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 12a4 4 0 0 1 8 0"/></svg>
                  {item.bread}
                </span>
                <span class="prop-spec">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 10l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
                  {item.cheese}
                </span>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>
    <div class="hscroll-progress" aria-hidden="true">
      <div class="hscroll-progress__bar" id="hscroll-bar"></div>
    </div>
  </div>

  <div class="featured-cta container reveal">
    <a href="#contacto" class="btn btn-gold">
      <span>Reservar Mesa para Degustación</span>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  </div>
</section>

<style>
.featured-props {
  background: var(--color-bg);
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-top: clamp(2rem, 4vh, 3.5rem);
  padding-bottom: clamp(2rem, 4vh, 3.5rem);
  overflow: hidden;
  position: relative;
}

.featured-props__header {
  max-width: 620px;
  margin-bottom: clamp(1rem, 2vh, 1.75rem);
}

.section-heading {
  font-size: clamp(1.9rem, 3.5vw, 2.9rem);
  color: #FFFFFF;
  margin-bottom: 0.4rem;
}

.highlight-text {
  font-family: var(--font-display);
  font-style: italic;
  background: var(--grad-flame);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.section-desc {
  color: var(--color-cream-muted);
  font-size: 0.88rem;
  line-height: 1.5;
  font-weight: 400;
}

/* ─── Horizontal Scroll ─────────────────────────────────── */
.hscroll-section {
  position: relative;
  margin-bottom: clamp(0.5rem, 1vh, 1rem);
  padding-block: 0.5rem;
}

.hscroll-track {
  display: flex;
  align-items: stretch;
  gap: 1.5rem;
  padding-left: var(--container-pad);
  padding-right: var(--container-pad);
  width: max-content;
  will-change: transform;
}

.hscroll-progress {
  height: 3px;
  background: rgba(255, 255, 255, 0.08);
  margin: 1rem var(--container-pad) 0;
  position: relative;
  border-radius: 9999px;
  overflow: hidden;
}

.hscroll-progress__bar {
  position: absolute;
  inset: 0;
  background: var(--grad-sunset);
  transform-origin: left;
  transform: scaleX(0);
  will-change: transform;
  box-shadow: 0 0 16px rgba(255, 87, 34, 0.9);
}

/* Card */
.prop-card {
  flex: 0 0 clamp(310px, 23vw, 350px);
  background: var(--color-bg-card);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: var(--radius-md);
  overflow: hidden;
  transition: transform 0.35s cubic-bezier(0.16,1,0.3,1), border-color 0.35s ease, box-shadow 0.35s ease;
  will-change: transform;
  position: relative;
}

.prop-card:hover {
  transform: translateY(-8px);
}

/* Multi-Color Card Styles */
.prop-card--violet:hover {
  border-color: #8B5CF6;
  box-shadow: 0 20px 50px rgba(0,0,0,0.8), 0 0 30px rgba(139, 92, 246, 0.3);
}
.prop-card--flame:hover {
  border-color: #FF5722;
  box-shadow: 0 20px 50px rgba(0,0,0,0.8), 0 0 30px rgba(255, 87, 34, 0.35);
}
.prop-card--mint:hover {
  border-color: #06D6A0;
  box-shadow: 0 20px 50px rgba(0,0,0,0.8), 0 0 30px rgba(6, 214, 160, 0.3);
}
.prop-card--saffron:hover {
  border-color: #FFB703;
  box-shadow: 0 20px 50px rgba(0,0,0,0.8), 0 0 30px rgba(255, 183, 3, 0.35);
}
.prop-card--cobalt:hover {
  border-color: #3B82F6;
  box-shadow: 0 20px 50px rgba(0,0,0,0.8), 0 0 30px rgba(59, 130, 246, 0.3);
}
.prop-card--ruby:hover {
  border-color: #EF233C;
  box-shadow: 0 20px 50px rgba(0,0,0,0.8), 0 0 30px rgba(239, 35, 60, 0.35);
}

.prop-card__link { display: flex; flex-direction: column; height: 100%; }

/* Image */
.prop-card__img-wrap {
  position: relative;
  overflow: hidden;
  aspect-ratio: 16 / 10;
  background: #090D16;
}

.prop-card__img {
  width: 100%; height: 100%;
  object-fit: cover;
  filter: brightness(0.9) contrast(1.1) saturate(1.05);
  transition: transform 0.7s cubic-bezier(0.16,1,0.3,1);
}

.prop-card:hover .prop-card__img {
  transform: scale(1.08);
}

/* Tag row */
.card-tag-row {
  position: absolute;
  top: 0.75rem;
  left: 0.75rem;
  right: 0.75rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-num {
  font-family: var(--font-display);
  font-size: 0.8rem;
  font-weight: 700;
  font-style: italic;
  color: #FFFFFF;
  background: rgba(11, 15, 25, 0.85);
  padding: 0.2rem 0.55rem;
  border: 1px solid rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8px);
  border-radius: var(--radius-sm);
}

/* Badges */
.prop-badge {
  font-size: 0.6rem;
  font-weight: 800;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  padding: 0.3rem 0.75rem;
  border-radius: var(--radius-pill);
}

.prop-badge--violet  { background: #8B5CF6; color: #FFFFFF; }
.prop-badge--flame   { background: #FF5722; color: #FFFFFF; }
.prop-badge--mint    { background: #06D6A0; color: #090D16; }
.prop-badge--saffron { background: #FFB703; color: #090D16; }
.prop-badge--cobalt  { background: #3B82F6; color: #FFFFFF; }
.prop-badge--ruby    { background: #EF233C; color: #FFFFFF; }

/* Overlay */
.prop-card__overlay {
  position: absolute;
  inset: 0;
  background: rgba(11, 15, 25, 0.75);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  color: #FFFFFF;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.prop-card:hover .prop-card__overlay { opacity: 1; }

/* Body */
.prop-card__body {
  padding: 1.15rem 1.35rem;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.prop-card__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.35rem;
}

.prop-meta-type {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-saffron);
}

.prop-card__price {
  font-family: var(--font-heading);
  font-size: 1.2rem;
  font-weight: 800;
  color: #FFFFFF;
}

.prop-card__title {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 0.35rem;
  line-height: 1.2;
}

.prop-card__notes {
  font-size: 0.8rem;
  color: var(--color-cream-muted);
  line-height: 1.5;
  margin-bottom: 0.7rem;
  font-weight: 400;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.prop-card__pairing {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.68rem;
  font-weight: 500;
  color: #F8FAFC;
  background: rgba(255, 255, 255, 0.06);
  padding: 0.35rem 0.65rem;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: var(--radius-sm);
  margin-bottom: 0.7rem;
}

.prop-card__pairing svg { flex-shrink: 0; color: var(--color-flame); width: 12px; height: 12px; }

.prop-card__specs {
  display: flex;
  gap: 0.85rem;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  padding-top: 0.65rem;
  margin-top: auto;
}

.prop-spec {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.68rem;
  color: var(--color-cream-muted);
  font-weight: 500;
}

.prop-spec svg { color: var(--color-saffron); flex-shrink: 0; width: 12px; height: 12px; }

.featured-cta { text-align: center; margin-top: clamp(0.75rem, 1.5vh, 1.25rem); }
.featured-cta .btn { padding: 0.75rem 1.8rem; font-size: 0.75rem; }

@media (max-width: 768px) {
  .featured-props { min-height: auto; padding-top: 4rem; padding-bottom: 4rem; }
  .hscroll-track { display: grid; grid-template-columns: 1fr; width: 100%; padding-inline: var(--container-pad); gap: 1.5rem; }
  .prop-card { flex: none; width: 100%; }
  .hscroll-progress { display: none; }
}
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const containerSection = document.getElementById('propiedades');
  const section = document.getElementById('hscroll-section');
  const track = document.getElementById('hscroll-track');
  const bar = document.getElementById('hscroll-bar');

  if (containerSection && section && track && window.innerWidth > 768) {
    const getAmt = () => {
      return Math.max(0, track.scrollWidth - window.innerWidth + 60);
    };

    // 1. Horizontal track pin and scrub
    gsap.to(track, {
      x: () => -getAmt(),
      ease: 'none',
      scrollTrigger: {
        trigger: containerSection,
        pin: true,
        start: 'top top',
        end: () => `+=${getAmt()}`,
        scrub: 0.8,
        invalidateOnRefresh: true,
        onUpdate: (self) => {
          if (bar) gsap.set(bar, { scaleX: self.progress });
        }
      }
    });

    // 2. Initial card entrance animation
    const cards = track.querySelectorAll<HTMLElement>('.prop-card');
    gsap.fromTo(cards,
      { opacity: 0, y: 35 },
      {
        opacity: 1,
        y: 0,
        duration: 0.85,
        stagger: 0.08,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: section,
          start: 'top 85%',
          toggleActions: 'play none none none',
          once: true,
        },
        onComplete: () => {
          gsap.set(cards, { clearProps: 'transform' });
        }
      }
    );

    // Refresh calculations once full page resources finish settling
    window.addEventListener('load', () => {
      ScrollTrigger.refresh();
    });
  }
</script>
