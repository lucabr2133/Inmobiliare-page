---
---

<section class="services" id="servicios">
  <div class="container">
    <div class="services__grid">
      <div class="services__left">
        <span class="section-label reveal">Servicios</span>
        <h2 class="section-title reveal">Asesoramiento<br /><em>integral</em></h2>
        <p class="section-subtitle reveal">
          Cada servicio está respaldado por un equipo multidisciplinario de profesionales
          del mercado inmobiliario, legales y financieros.
        </p>
      </div>

      <div class="services__right">
        <div class="svc reveal">
          <div class="svc__header">
            <h3>Compraventa de Propiedades</h3>
            <span class="svc__arrow">→</span>
          </div>
          <p>Gestión completa del proceso de compra y venta. Valuación de mercado, estrategia de comercialización, negociación y cierre de operación.</p>
        </div>
        <div class="svc reveal">
          <div class="svc__header">
            <h3>Alquileres & Administración</h3>
            <span class="svc__arrow">→</span>
          </div>
          <p>Alquileres temporarios y permanentes con administración integral: cobro, mantenimiento, seguros y atención al propietario.</p>
        </div>
        <div class="svc reveal">
          <div class="svc__header">
            <h3>Tasaciones Profesionales</h3>
            <span class="svc__arrow">→</span>
          </div>
          <p>Valuaciones con análisis comparativo de mercado, tendencias de zona y proyección de rentabilidad. Informe detallado en 48hs.</p>
        </div>
        <div class="svc reveal">
          <div class="svc__header">
            <h3>Consultoría de Inversión</h3>
            <span class="svc__arrow">→</span>
          </div>
          <p>Asesoramiento para inversores: análisis de proyectos en pozo, retorno por zona, diversificación de portfolio y estructuras fiduciarias.</p>
        </div>
        <div class="svc reveal">
          <div class="svc__header">
            <h3>Asesoramiento Legal</h3>
            <span class="svc__arrow">→</span>
          </div>
          <p>Equipo legal especializado en operaciones inmobiliarias: escrituras, hipotecas, contratos y due diligence patrimonial.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.services { background: var(--color-bg-alt); }

.services__grid {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: clamp(3rem, 6vw, 6rem);
  align-items: start;
}

.services__left { position: sticky; top: calc(var(--navbar-h) + 2rem); }

.services__right {
  display: flex;
  flex-direction: column;
}

.svc {
  padding: 1.75rem 0;
  border-bottom: 1px solid var(--color-border);
  cursor: default;
  transition: padding-left 0.3s ease;
}

.svc:first-child { border-top: 1px solid var(--color-border); }

.svc:hover { padding-left: 1rem; }

.svc__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.5rem;
}

.svc__header h3 {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 500;
  color: var(--color-dark);
}

.svc__arrow {
  color: var(--color-gold);
  font-size: 1.1rem;
  opacity: 0;
  transform: translateX(-8px);
  transition: all 0.3s ease;
}

.svc:hover .svc__arrow {
  opacity: 1;
  transform: translateX(0);
}

.svc p {
  font-size: 0.88rem;
  color: var(--color-text-light);
  line-height: 1.65;
  font-weight: 300;
  max-width: 500px;
}

@media (max-width: 900px) {
  .services__grid { grid-template-columns: 1fr; }
  .services__left { position: static; }
}
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray('.svc').forEach((el: any, i: number) => {
    gsap.fromTo(el,
      { opacity: 0, x: 30 },
      { opacity: 1, x: 0, duration: 0.7, delay: i * 0.08, ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 90%' } }
    );
  });
</script>
