---
// Services.astro — Experiencias Gastronómicas Multi-Color
---

<section class="section services" id="servicios" aria-labelledby="services-heading">
  <div class="container">
    <div class="services__header reveal">
      <span class="eyebrow">HOSPITALIDAD DE ALTA GAMA</span>
      <span class="gold-line"></span>
      <h2 class="display-heading services__heading" id="services-heading">
        Experiencias <span class="highlight-aurora">Inmersivas</span>
      </h2>
      <p class="services__desc">
        Más que una cena: una atmósfera diseñada al milímetro con iluminación tenue, vinilos en directo y servicio de mantel largo.
      </p>
    </div>

    <div class="services__grid" role="list">

      <!-- Experiencia 1: Ruby Sunset -->
      <div class="service-card service-card--ruby reveal reveal-delay-1" role="listitem" tabindex="0">
        <div class="service-card__top">
          <span class="service-card__num">№ 01</span>
          <div class="service-card__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
        </div>
        <h3 class="service-card__title">Salón Clandestino</h3>
        <p class="service-card__desc">
          Ambiente intimista en penumbras, sillones de terciopelo y barra de mármol negro. Música en vinilo seleccionada y servicio de mesa con cubertería francesa.
        </p>
        <a href="#contacto" class="service-card__link">
          <span>Reservar en Sala</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Experiencia 2: Flame Saffron -->
      <div class="service-card service-card--flame reveal reveal-delay-2" role="listitem" tabindex="0">
        <div class="service-card__top">
          <span class="service-card__num">№ 02</span>
          <div class="service-card__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          </div>
        </div>
        <h3 class="service-card__title">Chef's Table Omakase</h3>
        <p class="service-card__desc">
          Solo 8 comensales por servicio frente a las brasas. Menú degustación de 5 pasos con cortes no revelados en carta, maridados copa a copa por nuestro sommelier.
        </p>
        <a href="#contacto" class="service-card__link">
          <span>Pase Chef's Table</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Experiencia 3: Cobalt Violet -->
      <div class="service-card service-card--cobalt reveal reveal-delay-3" role="listitem" tabindex="0">
        <div class="service-card__top">
          <span class="service-card__num">№ 03</span>
          <div class="service-card__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M8 22h8M12 15v7M17 2l2 6H5l2-6h10z"/>
              <path d="M5 8c0 4.418 3.134 8 7 8s7-3.582 7-8H5z"/>
            </svg>
          </div>
        </div>
        <h3 class="service-card__title">La Cava & Mixología</h3>
        <p class="service-card__desc">
          Mixología de autor concebida con destilados premium, ahumados al soplete y maceraciones propias, junto a más de 120 etiquetas de vinos naturales.
        </p>
        <a href="#contacto" class="service-card__link">
          <span>Carta de Coctelería</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Experiencia 4: Mint Jade -->
      <div class="service-card service-card--mint reveal reveal-delay-4" role="listitem" tabindex="0">
        <div class="service-card__top">
          <span class="service-card__num">№ 04</span>
          <div class="service-card__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
        </div>
        <h3 class="service-card__title">Atelier Privé & Galas</h3>
        <p class="service-card__desc">
          Reserva completa del salón o catering VIP in situ para celebraciones exclusivas y eventos corporativos con cocina en vivo a cargo del chef ejecutivo.
        </p>
        <a href="#contacto" class="service-card__link">
          <span>Consultar Galas</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

    </div>
  </div>
</section>

<style>
.services {
  background: var(--color-bg);
  position: relative;
}

.services__header {
  margin-bottom: 4rem;
  max-width: 620px;
}

.services__heading {
  font-size: clamp(2.4rem, 4.5vw, 3.8rem);
  color: #FFFFFF;
  margin-bottom: 1rem;
}

.highlight-aurora {
  font-family: var(--font-display);
  font-style: italic;
  background: linear-gradient(135deg, #06D6A0 0%, #3B82F6 50%, #8B5CF6 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.services__desc {
  color: var(--color-cream-muted);
  font-size: var(--fs-md);
  line-height: var(--lh-loose);
  font-weight: 400;
}

/* Grid */
.services__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
}

/* Card */
.service-card {
  background: var(--color-bg-card);
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 2.25rem 1.75rem;
  display: flex;
  flex-direction: column;
  border-radius: var(--radius-md);
  position: relative;
  transition: transform 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
  overflow: hidden;
}

.service-card:hover {
  transform: translateY(-8px);
}

.service-card--ruby:hover {
  border-color: #EF233C;
  box-shadow: 0 20px 45px rgba(0,0,0,0.8), 0 0 30px rgba(239, 35, 60, 0.3);
}
.service-card--ruby .service-card__num,
.service-card--ruby .service-card__icon,
.service-card--ruby .service-card__link { color: #EF233C; }

.service-card--flame:hover {
  border-color: #FF5722;
  box-shadow: 0 20px 45px rgba(0,0,0,0.8), 0 0 30px rgba(255, 87, 34, 0.3);
}
.service-card--flame .service-card__num,
.service-card--flame .service-card__icon,
.service-card--flame .service-card__link { color: #FF5722; }

.service-card--cobalt:hover {
  border-color: #3B82F6;
  box-shadow: 0 20px 45px rgba(0,0,0,0.8), 0 0 30px rgba(59, 130, 246, 0.3);
}
.service-card--cobalt .service-card__num,
.service-card--cobalt .service-card__icon,
.service-card--cobalt .service-card__link { color: #3B82F6; }

.service-card--mint:hover {
  border-color: #06D6A0;
  box-shadow: 0 20px 45px rgba(0,0,0,0.8), 0 0 30px rgba(6, 214, 160, 0.3);
}
.service-card--mint .service-card__num,
.service-card--mint .service-card__icon,
.service-card--mint .service-card__link { color: #06D6A0; }

.service-card__top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.75rem;
}

.service-card__num {
  font-family: var(--font-heading);
  font-size: 1.25rem;
  font-weight: 800;
}

.service-card__icon {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.04);
}

.service-card__title {
  font-family: var(--font-display);
  font-size: 1.35rem;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 0.85rem;
  line-height: 1.2;
}

.service-card__desc {
  font-size: 0.85rem;
  color: var(--color-cream-muted);
  line-height: 1.65;
  font-weight: 400;
  margin-bottom: 2rem;
  flex: 1;
}

.service-card__link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: var(--ls-wide);
  text-transform: uppercase;
  transition: gap 0.3s ease;
  margin-top: auto;
}

.service-card:hover .service-card__link {
  gap: 0.85rem;
}

@media (max-width: 1100px) {
  .services__grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 600px) {
  .services__grid { grid-template-columns: 1fr; }
}
</style>
