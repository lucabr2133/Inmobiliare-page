---

<section class="section schedule" id="horarios">
  <div class="container">
    <div class="schedule__head reveal">
      <h2 class="display-title schedule__title">
        LIVE SCHEDULE <span class="highlight-volt">TERMINAL</span>
      </h2>
      <p class="schedule__desc">
        Monitoreo de aforo y cupos en tiempo real por cada turno de entrenamiento. Aforo máximo: 8 atletas por sesión de coaching.
      </p>
    </div>

    <!-- Schedule Terminal Box -->
    <div class="schedule-terminal reveal">
      <!-- Days Nav -->
      <div class="schedule-days-bar" role="tablist" aria-label="Días de la semana">
        {scheduleData.map((d, i) => (
          <button
            class={`schedule-day-btn ${i === 0 ? 'active' : ''}`}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            data-day={d.day}
          >
            <span class="day-short">{d.day}</span>
            <span class="day-full">{d.dayFull}</span>
          </button>
        ))}
      </div>

      <!-- Class Slots Lists -->
      <div class="schedule-content">
        {scheduleData.map((d, i) => (
          <div class={`schedule-day-panel ${i === 0 ? 'active' : ''}`} id={`day-${d.day}`}>
            <div class="slots-header">
              <span>HORA</span>
              <span>DISCIPLINA // PROTOCOLO</span>
              <span>HEAD COACH</span>
              <span>INTENSIDAD</span>
              <span>ESTADO</span>
              <span>ACCIÓN</span>
            </div>

            <div class="slots-list" role="list">
              {d.classes.map(c => (
                <div class="slot-row" role="listitem">
                  <div class="slot-col slot-time">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                    <span>{c.time}</span>
                  </div>

                  <div class="slot-col slot-name">
                    <span class="slot-tag">{c.tag}</span>
                    <strong class="slot-title">{c.name}</strong>
                  </div>

                  <div class="slot-col slot-coach">
                    <span>{c.coach}</span>
                  </div>

                  <div class="slot-col slot-intensity">
                    <span class="intensity-badge">{c.intensity}</span>
                  </div>

                  <div class="slot-col slot-spots">
                    <span class={`spots-pill ${c.spots === 'Lleno' ? 'spots-pill--full' : ''}`}>
                      {c.spots}
                    </span>
                  </div>

                  <div class="slot-col slot-action">
                    {c.spots !== 'Lleno' ? (
                      <a href="#vip-pass" class="btn btn-volt slot-btn">
                        <span>RESERVAR</span>
                      </a>
                    ) : (
                      <button class="btn btn-ghost slot-btn" disabled>
                        <span>LISTA ESPERA</span>
                      </button>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.schedule {
  background: var(--color-bg-alt);
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.schedule__head {
  max-width: 650px;
  margin-bottom: 3rem;
}

.schedule__title {
  font-size: clamp(2.6rem, 5vw, 4.5rem);
  margin-bottom: 1rem;
}

.schedule__desc {
  font-size: 0.95rem;
  color: var(--color-text-muted);
  line-height: 1.7;
}

/* Terminal Box */
.schedule-terminal {
  background: #080A0E;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.9);
}

/* Days Bar */
.schedule-days-bar {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  background: rgba(20, 23, 30, 0.6);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.schedule-day-btn {
  background: transparent;
  border: none;
  padding: 1.25rem 0.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.2rem;
  cursor: pointer;
  border-bottom: 3px solid transparent;
  transition: all 0.2s ease;
}

.schedule-day-btn:hover {
  background: rgba(255, 255, 255, 0.03);
}

.schedule-day-btn.active {
  background: rgba(217, 255, 0, 0.08);
  border-bottom-color: var(--color-volt);
}

.day-short {
  font-family: var(--font-tech);
  font-size: 1.25rem;
  font-weight: 700;
  color: #FFFFFF;
}

.schedule-day-btn.active .day-short {
  color: var(--color-volt);
}

.day-full {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  color: var(--color-text-muted);
  text-transform: uppercase;
}

/* Content */
.schedule-day-panel {
  display: none;
}

.schedule-day-panel.active {
  display: block;
}

.slots-header {
  display: grid;
  grid-template-columns: 140px 1.4fr 1.1fr 130px 100px 120px;
  gap: 1.5rem;
  padding: 1rem 2rem;
  background: rgba(255, 255, 255, 0.02);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  font-family: var(--font-mono);
  font-size: 0.62rem;
  color: var(--color-text-muted);
  letter-spacing: 0.1em;
}

.slots-list {
  display: flex;
  flex-direction: column;
}

.slot-row {
  display: grid;
  grid-template-columns: 140px 1.4fr 1.1fr 130px 100px 120px;
  gap: 1.5rem;
  align-items: center;
  padding: 1.25rem 2rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  transition: background 0.2s ease;
}

.slot-row:last-child {
  border-bottom: none;
}

.slot-row:hover {
  background: rgba(217, 255, 0, 0.03);
}

.slot-time {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--color-volt);
}

.slot-name {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.slot-tag {
  font-family: var(--font-mono);
  font-size: 0.6rem;
  font-weight: 800;
  padding: 0.2rem 0.5rem;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.06);
  color: #FFFFFF;
  border: 1px solid rgba(255, 255, 255, 0.15);
}

.slot-title {
  font-family: var(--font-tech);
  font-size: 0.95rem;
  color: #FFFFFF;
}

.slot-coach {
  font-size: 0.82rem;
  color: var(--color-text-muted);
}

.intensity-badge {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--color-titanium);
}

.spots-pill {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  font-weight: 700;
  color: var(--color-volt);
  background: rgba(217, 255, 0, 0.1);
  padding: 0.25rem 0.6rem;
  border-radius: var(--radius-sm);
  display: inline-block;
}

.spots-pill--full {
  color: var(--color-flame);
  background: rgba(255, 62, 62, 0.1);
}

.slot-btn {
  padding: 0.5rem 0.85rem;
  font-size: 0.68rem;
  width: 100%;
}

@media (max-width: 1024px) {
  .slots-header { display: none; }
  .slot-row {
    grid-template-columns: 1fr;
    gap: 0.75rem;
    padding: 1.5rem;
  }
  .schedule-days-bar { overflow-x: auto; }
}
</style>

<script>
  const dayBtns = document.querySelectorAll<HTMLButtonElement>('.schedule-day-btn');
  const dayPanels = document.querySelectorAll<HTMLElement>('.schedule-day-panel');

  dayBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const day = btn.dataset.day;
      dayBtns.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      dayPanels.forEach(p => p.classList.remove('active'));

      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      document.getElementById(`day-${day}`)?.classList.add('active');
    });
  });
</script>
