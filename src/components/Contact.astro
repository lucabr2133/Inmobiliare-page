---
---

<section class="contact" id="contacto">
  <div class="container">
    <div class="contact__grid">
      <div class="contact__info">
        <span class="section-label reveal">Contacto</span>
        <h2 class="section-title reveal">Conversemos sobre su próximo <em>proyecto</em></h2>
        <p class="section-subtitle reveal" style="margin-bottom:2.5rem;">
          Ya sea que busque comprar, vender, invertir o simplemente obtener una valuación
          profesional, estamos a su disposición.
        </p>
        <div class="contact__details reveal">
          <div class="contact__detail">
            <strong>Oficina Central</strong>
            <span>Av. Alvear 1580, Piso 12<br />Recoleta, CABA</span>
          </div>
          <div class="contact__detail">
            <strong>Teléfono</strong>
            <span>+54 9 11 5555-0000</span>
          </div>
          <div class="contact__detail">
            <strong>Email</strong>
            <span>info@inmobiliare.com.ar</span>
          </div>
          <div class="contact__detail">
            <strong>Horarios</strong>
            <span>Lun — Vie: 09:00 a 19:00<br />Sáb: 10:00 a 14:00</span>
          </div>
        </div>
      </div>

      <form class="contact__form reveal" onsubmit="event.preventDefault(); this.innerHTML='<div class=\'contact__success\'>Gracias por su consulta. Le responderemos a la brevedad.</div>';">
        <div class="contact__form-row">
          <input type="text" placeholder="Nombre completo" required />
          <input type="email" placeholder="Email" required />
        </div>
        <input type="tel" placeholder="Teléfono" />
        <select>
          <option value="">¿En qué podemos ayudarle?</option>
          <option>Quiero comprar una propiedad</option>
          <option>Quiero vender mi propiedad</option>
          <option>Busco alquilar</option>
          <option>Solicitar una tasación</option>
          <option>Consultoría de inversión</option>
          <option>Otra consulta</option>
        </select>
        <textarea rows="4" placeholder="Cuéntenos más sobre lo que necesita..."></textarea>
        <button type="submit" class="btn btn-gold" style="width:100%;">Enviar Consulta</button>
      </form>
    </div>
  </div>
</section>

<style>
.contact { background: var(--color-bg-alt); }

.contact__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(3rem, 6vw, 5rem);
  align-items: start;
}

.contact__details {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.contact__detail strong {
  display: block;
  color: var(--color-dark);
  font-size: 0.88rem;
  margin-bottom: 0.15rem;
  font-weight: 500;
}

.contact__detail span {
  font-size: 0.85rem;
  color: var(--color-text-light);
  font-weight: 300;
  line-height: 1.5;
}

.contact__form {
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  padding: 2.5rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.contact__form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.contact__form input,
.contact__form select,
.contact__form textarea {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  color: var(--color-dark);
  font-family: var(--font-sans);
  font-size: 0.88rem;
  padding: 0.85rem 1rem;
  width: 100%;
  transition: border-color 0.25s ease;
}

.contact__form input:focus,
.contact__form select:focus,
.contact__form textarea:focus {
  outline: none;
  border-color: var(--color-gold);
}

.contact__form textarea { resize: vertical; }

.contact__success {
  text-align: center;
  padding: 3rem 1rem;
  color: var(--color-gold);
  font-family: var(--font-display);
  font-size: 1.2rem;
  font-weight: 400;
}

@media (max-width: 768px) {
  .contact__grid { grid-template-columns: 1fr; }
  .contact__form-row { grid-template-columns: 1fr; }
}
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray('.contact .reveal').forEach((el: any) => {
    gsap.fromTo(el,
      { opacity: 0, y: 35 },
      { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 85%' } }
    );
  });
</script>
