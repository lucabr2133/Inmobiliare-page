---
// Contact.astro — Contacto / CTA section
---

<section class="contact" id="contacto">
  <div class="container">
    <div class="contact__grid">
      <div class="contact__info">
        <h2 class="section-title reveal">EMPEZÁ <span class="highlight-volt">HOY</span></h2>
        <p class="section-subtitle reveal">
          Agendá tu primera visita sin cargo. Conocé nuestras instalaciones y hablá con nuestros coaches.
        </p>
        <div class="contact__details reveal">
          <div class="contact__detail">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D9FF00" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 1 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <div>
              <strong>Palermo Soho</strong>
              <span>Gorriti 5120, CABA</span>
            </div>
          </div>
          <div class="contact__detail">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D9FF00" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 1 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <div>
              <strong>Recoleta</strong>
              <span>Av. Alvear 1890, CABA</span>
            </div>
          </div>
          <div class="contact__detail">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D9FF00" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <div>
              <strong>WhatsApp</strong>
              <span>+54 9 11 5491-0000</span>
            </div>
          </div>
          <div class="contact__detail">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D9FF00" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            <div>
              <strong>Horarios</strong>
              <span>Lun-Sáb 06:00-23:00 · Dom 08:00-20:00</span>
            </div>
          </div>
        </div>
      </div>

      <form class="contact__form reveal" onsubmit="event.preventDefault(); this.innerHTML='<div class=\'contact__success\'>✓ Mensaje enviado. Te contactamos pronto.</div>';">
        <div class="contact__form-row">
          <input type="text" placeholder="Nombre completo" required />
          <input type="email" placeholder="Email" required />
        </div>
        <input type="tel" placeholder="Teléfono" />
        <select>
          <option value="">¿Qué te interesa?</option>
          <option>Membresía Starter</option>
          <option>Membresía Performance</option>
          <option>Membresía Élite</option>
          <option>1-Day Pass Gratuito</option>
          <option>Consulta General</option>
        </select>
        <textarea rows="4" placeholder="Mensaje (opcional)"></textarea>
        <button type="submit" class="btn btn-volt" style="width:100%;">ENVIAR CONSULTA</button>
      </form>
    </div>
  </div>
</section>

<style>
.contact {
  background: var(--color-bg);
}

.contact__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(3rem, 6vw, 5rem);
  align-items: start;
}

.contact__info .section-subtitle {
  margin-bottom: 2rem;
}

.contact__details {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.contact__detail {
  display: flex;
  gap: 0.85rem;
  align-items: flex-start;
}

.contact__detail strong {
  display: block;
  color: #FFFFFF;
  font-size: 0.9rem;
  margin-bottom: 0.15rem;
}

.contact__detail span {
  font-size: 0.85rem;
  color: var(--color-text-muted);
}

.contact__form {
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: 12px;
  padding: 2rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.contact__form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.contact__form input,
.contact__form select,
.contact__form textarea {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  color: #FFFFFF;
  font-family: var(--font-sans);
  font-size: 0.9rem;
  padding: 0.85rem 1rem;
  border-radius: 6px;
  transition: border-color 0.2s ease;
  width: 100%;
}

.contact__form input:focus,
.contact__form select:focus,
.contact__form textarea:focus {
  outline: none;
  border-color: var(--color-volt);
}

.contact__form textarea {
  resize: vertical;
}

.contact__success {
  text-align: center;
  padding: 3rem 1rem;
  color: var(--color-volt);
  font-family: var(--font-tech);
  font-size: 1.2rem;
}

@media (max-width: 768px) {
  .contact__grid { grid-template-columns: 1fr; }
  .contact__form-row { grid-template-columns: 1fr; }
}
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray('.contact .reveal').forEach((el: any) => {
    gsap.fromTo(el,
      { opacity: 0, y: 40 },
      {
        opacity: 1, y: 0, duration: 0.8, ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 85%' }
      }
    );
  });
</script>
