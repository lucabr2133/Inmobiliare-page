---
// Blog.astro — Las Crónicas del Atelier (Multi-Color)
const posts = [
  {
    id: 1,
    category: 'CIENCIA & CARNE',
    categoryColor: 'ruby',
    date: '14 AGOSTO, 2025',
    title: 'La Arquitectura de la Grasa: Por qué el Wagyu A5 revoluciona el Smash',
    excerpt: 'El punto de fusión de la grasa monoinsaturada del Wagyu se sitúa a 25°C. Analizamos la termodinámica de cocción y por qué se traduce en una untuosidad inalcanzable con carnes convencionales.',
    image: 'https://images.pexels.com/photos/769289/pexels-photo-769289.jpeg?auto=compress&cs=tinysrgb&w=700&h=460&dpr=1',
    alt: 'Carne Wagyu a la parrilla con marmoleo visible y brasa ardiente',
    readTime: '4 MIN'
  },
  {
    id: 2,
    category: 'PANADERÍA & QUÍMICA',
    categoryColor: 'saffron',
    date: '02 AGOSTO, 2025',
    title: 'Masa Madre Viva 48h: La Estructura Alveolar del Brioche de Papa',
    excerpt: 'Una hamburguesa de autor fracasa si el pan absorbe líquido sin retener su elasticidad. Desvelamos el proceso de doble amasado con manteca avellanada y fécula de papa andina.',
    image: 'https://images.pexels.com/photos/1756062/pexels-photo-1756062.jpeg?auto=compress&cs=tinysrgb&w=700&h=460&dpr=1',
    alt: 'Pan brioche artesanal dorado recién horneado',
    readTime: '6 MIN'
  },
  {
    id: 3,
    title: 'Crioterapia Celular a -110°C: Protocolos de Aclaramiento de Lactato',
    excerpt: 'El impacto fisiológico de los choques térmicos extremos en la biogénesis mitocondrial, la respuesta antiinflamatoria y la longevidad neuromuscular.',
    category: 'Biohacking & Recovery',
    categoryColor: 'flame',
    readTime: '5 MIN',
    date: '04 AGO 2025',
    image: 'https://images.pexels.com/photos/3757942/pexels-photo-3757942.jpeg?auto=compress&cs=tinysrgb&w=700&h=460&dpr=1',
    alt: 'Zona de crioterapia y sauna infrarrojo en APEX Sanctuary'
  },
];
---

<section class="section blog" id="blog" aria-labelledby="blog-heading">
  <div class="container">
    <div class="blog__header reveal">
      <span class="eyebrow">CIENCIA DEL RENDIMIENTO</span>
      <span class="volt-line"></span>
      <h2 class="display-heading blog__heading" id="blog-heading">
        Investigación &amp; <span class="highlight-volt">Biohacking</span>
      </h2>
      <p class="blog__desc">
        Ensayos de fisiología del ejercicio, protocolos de nutrición molecular y ciencia aplicada elaborados por nuestro comité médico y head coaches.
      </p>
    </div>

    <div class="blog__grid" role="list" aria-label="Artículos y ensayos científicos">
      {posts.map((post, i) => (
        <article class={`blog-card blog-card--${post.categoryColor} reveal reveal-delay-${i + 1}`} role="listitem" aria-label={post.title}>
          <div class="blog-card__inner">
            <div class="blog-card__img-wrap">
              <img
                src={post.image}
                alt={post.alt}
                class="blog-card__img"
                loading="lazy"
                width="700"
                height="460"
              />
              <span class={`blog-card__category blog-card__category--${post.categoryColor}`}>{post.category}</span>
            </div>
            <div class="blog-card__body">
              <div class="blog-card__meta">
                <time class="blog-card__date">{post.date}</time>
                <span class="blog-card__read-time">{post.readTime} LECTURA</span>
              </div>
              <h3 class="blog-card__title">{post.title}</h3>
              <p class="blog-card__excerpt">{post.excerpt}</p>
              <a href="#contacto" class="blog-card__cta">
                <span>Leer Ensayo</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.blog {
  background: var(--color-bg-alt);
  position: relative;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.blog__header {
  margin-bottom: 3.5rem;
  max-width: 640px;
}

.blog__heading {
  font-size: clamp(2.4rem, 4.5vw, 3.8rem);
  color: #FFFFFF;
  margin-bottom: 1rem;
}

.highlight-volt {
  background: var(--grad-volt);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.blog__desc {
  color: var(--color-cream-muted);
  font-size: var(--fs-md);
  line-height: var(--lh-loose);
  font-weight: 400;
}

/* Grid */
.blog__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}

/* Card */
.blog-card {
  background: var(--color-bg-card);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-md);
  overflow: hidden;
  transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
  display: flex;
  flex-direction: column;
}

.blog-card:hover {
  transform: translateY(-8px);
}

.blog-card--volt:hover {
  border-color: var(--color-volt);
  box-shadow: 0 20px 45px rgba(0,0,0,0.85), 0 0 30px rgba(204, 255, 0, 0.3);
}

.blog-card--cyan:hover {
  border-color: var(--color-cyan);
  box-shadow: 0 20px 45px rgba(0,0,0,0.85), 0 0 30px rgba(0, 240, 255, 0.3);
}

.blog-card--flame:hover {
  border-color: var(--color-flame);
  box-shadow: 0 20px 45px rgba(0,0,0,0.85), 0 0 30px rgba(255, 85, 0, 0.3);
}

.blog-card__inner {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* Image */
.blog-card__img-wrap {
  position: relative;
  overflow: hidden;
  aspect-ratio: 16 / 10;
  background: #080C14;
}

.blog-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(0.85) contrast(1.15);
  transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
}

.blog-card:hover .blog-card__img {
  transform: scale(1.06);
}

/* Category Badge */
.blog-card__category {
  position: absolute;
  top: 1rem;
  left: 1rem;
  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  padding: 0.35rem 0.8rem;
  border-radius: var(--radius-pill);
  backdrop-filter: blur(8px);
}

.blog-card__category--volt  { background: var(--color-volt); color: #080C14; }
.blog-card__category--cyan  { background: var(--color-cyan); color: #080C14; }
.blog-card__category--flame { background: var(--color-flame); color: #FFFFFF; }

/* Body */
.blog-card__body {
  padding: 1.75rem;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.blog-card__meta {
  display: flex;
  align-items: center;
  gap: 1rem;
  font-size: 0.72rem;
  color: var(--color-cream-muted);
  margin-bottom: 0.75rem;
  font-weight: 700;
}

.blog-card__read-time {
  color: var(--color-volt);
  font-weight: 800;
}

.blog-card__title {
  font-family: var(--font-heading);
  font-size: 1.2rem;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.35;
  margin-bottom: 0.75rem;
  text-transform: uppercase;
}

.blog-card__excerpt {
  font-size: 0.85rem;
  color: var(--color-cream-muted);
  line-height: 1.65;
  font-weight: 400;
  margin-bottom: 1.5rem;
  flex: 1;
}

/* CTA */
.blog-card__cta {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: var(--ls-wide);
  text-transform: uppercase;
  color: var(--color-volt);
  transition: gap var(--transition-fast);
  margin-top: auto;
}

.blog-card:hover .blog-card__cta {
  gap: 0.85rem;
}

@media (max-width: 992px) {
  .blog__grid { grid-template-columns: 1fr; max-width: 540px; margin-inline: auto; }
}
</style>
