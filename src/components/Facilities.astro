---
// Facilities.astro — Instalaciones / Gallery
---

<section class="facilities" id="instalaciones">
  <div class="container">
    <div class="facilities__header">
      <h2 class="section-title reveal">NUESTRAS <span class="highlight-volt">INSTALACIONES</span></h2>
      <p class="section-subtitle reveal">
        2.500 m² diseñados para potenciar cada aspecto de tu entrenamiento.
      </p>
    </div>

    <div class="facilities__gallery">
      <div class="fac-item fac-item--large reveal">
        <img src="https://images.pexels.com/photos/1552242/pexels-photo-1552242.jpeg?auto=compress&cs=tinysrgb&w=900" alt="Zona de pesas libres" />
        <div class="fac-item__overlay">
          <h3>Zona Olímpica</h3>
          <p>8 plataformas completas Eleiko IWF</p>
        </div>
      </div>
      <div class="fac-item reveal">
        <img src="https://images.pexels.com/photos/4162487/pexels-photo-4162487.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Zona funcional" />
        <div class="fac-item__overlay">
          <h3>Área Funcional</h3>
          <p>500 m² de turf y equipos</p>
        </div>
      </div>
      <div class="fac-item reveal">
        <img src="https://images.pexels.com/photos/3822906/pexels-photo-3822906.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Sala de recovery" />
        <div class="fac-item__overlay">
          <h3>Recovery Lab</h3>
          <p>Crioterapia y saunas</p>
        </div>
      </div>
      <div class="fac-item reveal">
        <img src="https://images.pexels.com/photos/4164761/pexels-photo-4164761.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Zona cardio" />
        <div class="fac-item__overlay">
          <h3>Cardio Zone</h3>
          <p>Concept2, Assault Bikes, SkiErg</p>
        </div>
      </div>
      <div class="fac-item reveal">
        <img src="https://images.pexels.com/photos/6551174/pexels-photo-6551174.jpeg?auto=compress&cs=tinysrgb&w=600" alt="HYROX Arena" />
        <div class="fac-item__overlay">
          <h3>HYROX Arena</h3>
          <p>Pista de 40m + simuladores</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.facilities {
  background: #080808;
}

.facilities__header {
  text-align: center;
  margin-bottom: clamp(3rem, 5vw, 4rem);
}

.facilities__header .section-subtitle { margin-inline: auto; }

.facilities__gallery {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: auto auto;
  gap: 1rem;
}

.fac-item {
  position: relative;
  border-radius: 8px;
  overflow: hidden;
  aspect-ratio: 16/10;
}

.fac-item--large {
  grid-column: 1 / 3;
  grid-row: 1 / 3;
  aspect-ratio: auto;
}

.fac-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.fac-item:hover img {
  transform: scale(1.06);
}

.fac-item__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(10,10,10,0.9) 0%, transparent 60%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 1.25rem;
  opacity: 0;
  transition: opacity 0.35s ease;
}

.fac-item:hover .fac-item__overlay {
  opacity: 1;
}

.fac-item__overlay h3 {
  font-family: var(--font-tech);
  font-size: 1.1rem;
  color: #FFFFFF;
  margin-bottom: 0.2rem;
}

.fac-item__overlay p {
  font-size: 0.8rem;
  color: var(--color-volt);
}

@media (max-width: 768px) {
  .facilities__gallery {
    grid-template-columns: 1fr 1fr;
  }
  .fac-item--large { grid-column: 1 / -1; grid-row: auto; aspect-ratio: 16/9; }
  .fac-item__overlay { opacity: 1; }
}
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray('.fac-item').forEach((item: any, i: number) => {
    gsap.fromTo(item,
      { opacity: 0, scale: 0.92 },
      {
        opacity: 1, scale: 1, duration: 0.7,
        delay: i * 0.1,
        ease: 'power2.out',
        scrollTrigger: { trigger: item, start: 'top 90%' }
      }
    );
  });
</script>
