---
// Footer.astro — High-Tech Brutalist Athletic Footer (No Blue, Clean Links)
---

<footer class="hud-footer" role="contentinfo">
  <div class="container hud-footer__inner">
    <!-- Top Row -->
    <div class="hud-footer__top">
      <div class="hud-footer__brand">
        <div class="hud-footer__logo">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M13 2L3 14H12L11 22L21 10H12L13 2Z" fill="#D9FF00"/>
          </svg>
          <span>APEX ATHLETIC CLUB</span>
        </div>
        <p class="hud-footer__doctrine">
          Santuario biomecánico de alto rendimiento, periodización de fuerza y biohacking celular en Buenos Aires. Equipamiento olímpico Eleiko IWF y crioterapia a -110°C.
        </p>
        <div class="hud-footer__coords">
          <span>PALERMO SOHO · RECOLETA · BUENOS AIRES</span>
        </div>
      </div>

      <!-- Navigation Matrix -->
      <div class="hud-footer__col">
        <span class="hud-footer__col-title">NAVEGACIÓN</span>
        <ul class="hud-footer__links">
          <li><a href="#zonas">Facility Blueprint</a></li>
          <li><a href="#disciplinas">Program Matrix</a></li>
          <li><a href="#horarios">Live Timetable</a></li>
          <li><a href="#coaches">Master Coaches</a></li>
          <li><a href="#biohacking">Recovery Chamber</a></li>
          <li><a href="#membresias">Pass Builder</a></li>
        </ul>
      </div>

      <!-- Locations -->
      <div class="hud-footer__col">
        <span class="hud-footer__col-title">SEDES BUENOS AIRES</span>
        <div class="loc-item">
          <span class="loc-tag">PALERMO SOHO</span>
          <p class="loc-txt">Gorriti 5120, CABA<br />+54 11 4899-2739</p>
        </div>
        <div class="loc-item">
          <span class="loc-tag">RECOLETA</span>
          <p class="loc-txt">Av. Alvear 1890, CABA<br />+54 11 4899-2740</p>
        </div>
      </div>

      <!-- Newsletter -->
      <div class="hud-footer__col">
        <span class="hud-footer__col-title">APEX JOURNAL</span>
        <p class="hud-footer__news-txt">
          Protocolos de fisiología deportiva, papers de biomecánica y cupos anticipados a workshops olímpicos.
        </p>
        <form class="hud-footer__form" onsubmit="event.preventDefault(); this.innerHTML='<span style=\'color:var(--color-volt);font-size:0.75rem;font-family:var(--font-mono);\'>// SUSCRIPCIÓN ACTIVA</span>';">
          <input type="email" placeholder="tu@email.com" required aria-label="Email para newsletter" />
          <button type="submit" class="btn btn-volt" aria-label="Enviar">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </form>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="hud-footer__bottom">
      <p class="hud-footer__copy">
        &copy; {new Date().getFullYear()} APEX Performance Club. Todos los derechos reservados.
      </p>
      <div class="hud-footer__bottom-links">
        <a href="#vip-pass">Términos de Sala</a>
        <a href="#vip-pass">Privacidad &amp; Datos Biométricos</a>
        <a href="#vip-pass">Reglamento IWF</a>
      </div>
    </div>
  </div>
</footer>

<style>
.hud-footer {
  background: #06070A;
  border-top: 1px solid var(--color-border-volt);
  padding-top: clamp(4rem, 8vw, 6rem);
  padding-bottom: 2.5rem;
}

.hud-footer__top {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
  gap: 3rem;
  padding-bottom: 3.5rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.hud-footer__brand {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.hud-footer__logo {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  font-family: var(--font-tech);
  font-size: 1.2rem;
  font-weight: 700;
  color: #FFFFFF;
}

.hud-footer__doctrine {
  font-size: 0.82rem;
  color: var(--color-text-muted);
  line-height: 1.65;
}

.hud-footer__coords {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--color-volt);
  margin-top: 0.5rem;
}

/* Columns */
.hud-footer__col {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.hud-footer__col-title {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--color-volt);
  letter-spacing: 0.1em;
}

.hud-footer__links {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}

.hud-footer__links a {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--color-text-muted);
  text-decoration: none;
  transition: color 0.2s ease, transform 0.2s ease;
  display: inline-block;
}

.hud-footer__links a:hover {
  color: var(--color-volt);
  transform: translateX(4px);
}

.loc-item {
  margin-bottom: 0.65rem;
}

.loc-tag {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  color: #FFFFFF;
  display: block;
  margin-bottom: 0.2rem;
}

.loc-txt {
  font-size: 0.78rem;
  color: var(--color-text-muted);
  line-height: 1.5;
}

.hud-footer__news-txt {
  font-size: 0.8rem;
  color: var(--color-text-muted);
  line-height: 1.5;
}

.hud-footer__form {
  display: flex;
  gap: 0.5rem;
  margin-top: 0.5rem;
}

.hud-footer__form input {
  background: rgba(20, 23, 30, 0.8);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-sm);
  padding: 0.65rem 0.85rem;
  color: #FFFFFF;
  font-size: 0.8rem;
  flex: 1;
}

.hud-footer__form input:focus {
  outline: none;
  border-color: var(--color-volt);
}

.hud-footer__form button {
  padding: 0.65rem 1rem;
}

/* Bottom */
.hud-footer__bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 2rem;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--color-text-muted);
  flex-wrap: wrap;
  gap: 1rem;
}

.hud-footer__bottom-links {
  display: flex;
  gap: 1.5rem;
}

.hud-footer__bottom-links a {
  color: var(--color-text-muted);
  text-decoration: none;
  transition: color 0.2s ease;
}

.hud-footer__bottom-links a:hover {
  color: #FFFFFF;
}

@media (max-width: 1024px) {
  .hud-footer__top { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 600px) {
  .hud-footer__top { grid-template-columns: 1fr; }
  .hud-footer__bottom { flex-direction: column; align-items: flex-start; }
}
</style>
