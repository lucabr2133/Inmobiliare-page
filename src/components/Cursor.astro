---
// Cursor.astro — Premium magnetic cursor
---

<div class="cursor" id="cursor" aria-hidden="true">
  <div class="cursor__dot"></div>
  <div class="cursor__ring"></div>
</div>

<style>
/* Hide on touch devices */
@media (hover: none) {
  .cursor { display: none !important; }
}

.cursor {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 9999;
  pointer-events: none;
  mix-blend-mode: normal;
}

.cursor__dot {
  position: absolute;
  top: -4px;
  left: -4px;
  width: 8px;
  height: 8px;
  background: var(--color-flame);
  box-shadow: 0 0 10px rgba(255, 87, 34, 0.8);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  will-change: transform;
}

.cursor__ring {
  position: absolute;
  top: -20px;
  left: -20px;
  width: 40px;
  height: 40px;
  border: 1.5px solid rgba(255, 183, 3, 0.6);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  will-change: transform;
  transition: width 0.3s ease, height 0.3s ease, border-color 0.3s ease, background 0.3s ease;
}

.cursor--hover .cursor__ring {
  width: 58px;
  height: 58px;
  border-color: var(--color-flame);
  background: rgba(255, 87, 34, 0.12);
  box-shadow: 0 0 20px rgba(255, 87, 34, 0.3);
}

.cursor--click .cursor__dot {
  transform: translate(-50%, -50%) scale(0.5);
}

.cursor--text .cursor__ring {
  width: 80px;
  height: 80px;
  border-color: rgba(201, 169, 110, 0.4);
}

.cursor--hidden .cursor__dot,
.cursor--hidden .cursor__ring {
  opacity: 0;
}
</style>

<script>
import gsap from 'gsap';

const cursor = document.getElementById('cursor');
if (!cursor) throw new Error('Cursor not found');

// Only activate on devices that support hover
if (window.matchMedia('(hover: hover)').matches) {
  document.documentElement.style.cursor = 'none';

  const dot = cursor.querySelector('.cursor__dot') as HTMLElement;
  const ring = cursor.querySelector('.cursor__ring') as HTMLElement;

  let mouseX = window.innerWidth / 2;
  let mouseY = window.innerHeight / 2;
  let ringX = mouseX;
  let ringY = mouseY;

  // Track mouse
  document.addEventListener('mousemove', (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;

    // Dot follows immediately
    gsap.set(cursor, { x: mouseX, y: mouseY });
  }, { passive: true });

  // Ring follows with lag using ticker
  gsap.ticker.add(() => {
    ringX += (mouseX - ringX) * 0.12;
    ringY += (mouseY - ringY) * 0.12;
    gsap.set(ring, { x: ringX - mouseX, y: ringY - mouseY });
  });

  // Hover states for cursor expansion
  const hoverTargets = document.querySelectorAll<HTMLElement>(
    'a, button, .prop-card, .service-card, .stat-item, .blog-card, .carousel__btn, [role="tab"]'
  );

  hoverTargets.forEach((el) => {
    el.addEventListener('mouseenter', () => {
      cursor?.classList.add('cursor--hover');
    });
    el.addEventListener('mouseleave', () => {
      cursor?.classList.remove('cursor--hover');
    });
  });

  // Magnetic pull exclusively for interactive buttons
  const magneticButtons = document.querySelectorAll<HTMLElement>('.btn, .carousel__btn, .social-link');
  magneticButtons.forEach((btn) => {
    btn.addEventListener('mousemove', (e) => {
      const rect = btn.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const dx = e.clientX - cx;
      const dy = e.clientY - cy;
      gsap.to(btn, {
        x: dx * 0.25,
        y: dy * 0.25,
        duration: 0.3,
        ease: 'power2.out',
      });
    });
    btn.addEventListener('mouseleave', () => {
      gsap.to(btn, {
        x: 0,
        y: 0,
        duration: 0.4,
        ease: 'elastic.out(1, 0.4)',
        clearProps: 'transform',
      });
    });
  });

  // Click feedback
  document.addEventListener('mousedown', () => cursor?.classList.add('cursor--click'));
  document.addEventListener('mouseup', () => cursor?.classList.remove('cursor--click'));

  // Hide when leaving window
  document.addEventListener('mouseleave', () => cursor?.classList.add('cursor--hidden'));
  document.addEventListener('mouseenter', () => cursor?.classList.remove('cursor--hidden'));
}
</script>
