---
// ContactTerminal.astro — Futuristic VIP Pass Application Terminal (No Blue, No Top Tag)
---

<section class="section terminal-contact" id="vip-pass">
  <div class="container">
    <div class="terminal-contact__grid">
      <!-- Left: Terminal Directives -->
      <div class="terminal-directives reveal">
        <h2 class="display-title terminal-directives__title">
          1-DAY VIP <span class="highlight-volt">PASS</span>
        </h2>
        <p class="terminal-directives__desc">
          Disfruta de un día completo de entrenamiento de élite sin cargo en nuestras instalaciones de Palermo Soho o Recoleta. Incluye acceso total a las 6 zonas, evaluación con Head Coach y sesión en el Recovery Spa.
        </p>

        <div class="terminal-info-blocks">
          <div class="info-block">
            <span class="info-block__tag">SEDES // BUENOS AIRES</span>
            <p class="info-block__val">Palermo Soho (Gorriti 5120) · Recoleta (Av. Alvear 1890)</p>
          </div>
          <div class="info-block">
            <span class="info-block__tag">HORARIO // CONTROL DE ACCESO</span>
            <p class="info-block__val">Lunes a Viernes: 06:00 – 23:00 · Sábados &amp; Domingos: 08:00 – 20:00</p>
          </div>
          <div class="info-block">
            <span class="info-block__tag">CONCIERGE // WHATSAPP DIRECTO</span>
            <p class="info-block__val">+54 11 4899-2739 · vip@apexclub.com.ar</p>
          </div>
        </div>
      </div>

      <!-- Right: Interactive Terminal Form -->
      <div class="terminal-form-card reveal">
        <div class="terminal-form-head">
          <span class="pulse-dot"></span>
          <span class="form-sys-id">VIP PASS ISSUING SYSTEM // AFORO LIMITADO</span>
        </div>

        <form class="terminal-form" id="vip-form">
          <div class="form-row">
            <div class="form-field">
              <label for="fname">NOMBRE COMPLETO *</label>
              <input type="text" id="fname" required placeholder="Ej: Santiago Albarracín" />
            </div>
            <div class="form-field">
              <label for="femail">EMAIL CORPORATIVO / PERSONAL *</label>
              <input type="email" id="femail" required placeholder="santiago@email.com" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-field">
              <label for="fphone">WHATSAPP MÓVIL *</label>
              <input type="tel" id="fphone" required placeholder="+54 9 11 ..." />
            </div>
            <div class="form-field">
              <label for="floc">SEDE DE PREFERENCIA *</label>
              <select id="floc" required>
                <option value="palermo">Palermo Soho — Gorriti 5120</option>
                <option value="recoleta">Recoleta — Av. Alvear 1890</option>
              </select>
            </div>
          </div>

          <div class="form-field">
            <label for="fgoal">OBJETIVO PRINCIPAL DE RENDIMIENTO *</label>
            <select id="fgoal" required>
              <option value="hyrox">Hyrox &amp; Rendimiento Metabólico</option>
              <option value="fuerza">Halterofilia Olímpica &amp; Fuerza Pura</option>
              <option value="hipertrofia">Hipertrofia Biomecánica 3D</option>
              <option value="biohacking">Longevidad Celular &amp; Crioterapia</option>
              <option value="combate">Boxeo de Combate &amp; Striking</option>
            </select>
          </div>

          <div class="form-field">
            <label for="fnotes">NOTAS AL HEAD COACH (OPCIONAL)</label>
            <textarea id="fnotes" rows="3" placeholder="Historial de lesiones, marcas actuales o metas específicas..."></textarea>
          </div>

          <button type="submit" class="btn btn-volt terminal-submit">
            <span>EMITIR MI 1-DAY VIP PASS GRATUITO</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>

          <p class="form-footer-txt">
            Tu solicitud será procesada por nuestro concierge en menos de 2 horas para confirmar tu horario de bienvenida y protocolo de acceso.
          </p>

          <div class="form-issued-box" id="issued-box" hidden>
            <span class="issued-icon">⚡</span>
            <div>
              <strong style="color:var(--color-volt);display:block;margin-bottom:0.2rem;">¡1-DAY VIP PASS GENERADO!</strong>
              <p style="font-size:0.8rem;color:#FFFFFF;">Hemos reservado tu pase. Los detalles de acceso y vestuario fueron enviados a tu WhatsApp.</p>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
.terminal-contact {
  background: var(--color-bg);
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.terminal-contact__grid {
  display: grid;
  grid-template-columns: 1fr 1.25fr;
  gap: clamp(3rem, 6vw, 6rem);
  align-items: center;
}

.terminal-directives__title {
  font-size: clamp(2.6rem, 5vw, 4.5rem);
  margin-bottom: 1.25rem;
}

.terminal-directives__desc {
  font-size: 0.95rem;
  color: var(--color-text-muted);
  line-height: 1.7;
  margin-bottom: 2.5rem;
}

.terminal-info-blocks {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.info-block {
  background: var(--color-bg-card);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-left: 3px solid var(--color-volt);
  padding: 1.15rem 1.5rem;
  border-radius: var(--radius-sm);
}

.info-block__tag {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  color: var(--color-volt);
  display: block;
  margin-bottom: 0.25rem;
}

.info-block__val {
  font-size: 0.85rem;
  color: #FFFFFF;
  font-weight: 600;
}

/* Form Card */
.terminal-form-card {
  background: #080A0E;
  border: 1.5px solid var(--color-border-volt);
  border-radius: var(--radius-md);
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9);
  overflow: hidden;
}

.terminal-form-head {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  background: rgba(20, 23, 30, 0.8);
  padding: 1rem 1.75rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.form-sys-id {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--color-volt);
  letter-spacing: 0.1em;
}

.terminal-form {
  padding: 2.25rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.form-field label {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--color-text-muted);
  letter-spacing: 0.08em;
}

.form-field input,
.form-field select,
.form-field textarea {
  background: rgba(20, 23, 30, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-sm);
  padding: 0.85rem 1rem;
  color: #FFFFFF;
  font-family: var(--font-body);
  font-size: 0.85rem;
  transition: border-color 0.25s ease, box-shadow 0.25s ease;
}

.form-field input:focus,
.form-field select:focus,
.form-field textarea:focus {
  outline: none;
  border-color: var(--color-volt);
  box-shadow: 0 0 15px rgba(217, 255, 0, 0.3);
}

.form-field select {
  cursor: pointer;
}

.form-field select option {
  background: #080A0E;
  color: #FFFFFF;
}

.terminal-submit {
  width: 100%;
  padding: 1.1rem;
  margin-top: 0.5rem;
}

.form-footer-txt {
  font-size: 0.72rem;
  color: var(--color-text-muted);
  text-align: center;
  line-height: 1.5;
}

.form-issued-box {
  background: rgba(217, 255, 0, 0.1);
  border: 1px solid var(--color-volt);
  padding: 1.25rem;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  gap: 1rem;
}

.issued-icon { font-size: 1.8rem; }

@media (max-width: 960px) {
  .terminal-contact__grid { grid-template-columns: 1fr; }
  .form-row { grid-template-columns: 1fr; }
}
</style>

<script>
  const form = document.getElementById('vip-form') as HTMLFormElement;
  const issuedBox = document.getElementById('issued-box');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (form.checkValidity()) {
      issuedBox?.removeAttribute('hidden');
    } else {
      form.reportValidity();
    }
  });
</script>
