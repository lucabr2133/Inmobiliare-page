---
// Stats.astro — Métricas de Rendimiento APEX
---

<section class="section stats" id="estadisticas" aria-labelledby="stats-heading">
  <!-- Dynamic Background with Performance Aura -->
  <div class="stats__bg" aria-hidden="true">
    <img
      src="https://images.pexels.com/photos/841130/pexels-photo-841130.jpeg?auto=compress&cs=tinysrgb&w=1920&h=1080&dpr=1"
      alt="Zona de pesas y fuerza en APEX Performance Club"
      class="stats__bg-img"
      loading="lazy"
    />
    <div class="stats__overlay"></div>
  </div>

  <div class="container stats__content">
    <div class="stats__intro reveal">
      <span class="eyebrow">EL IMPACTO EN NÚMEROS</span>
      <span class="volt-line volt-line--center"></span>
      <h2 class="display-heading stats__heading" id="stats-heading">
        Métricas de <span class="highlight-volt">Rendimiento</span>
      </h2>
    </div>

    <!-- 4 High-Impact Counters -->
    <div class="stats__grid" role="list">

      <div class="stat-item stat-item--volt reveal reveal-delay-1" role="listitem">
        <div class="stat-number-wrap">
          <span class="stat-number" data-target="15000">0</span>
          <span class="stat-unit">KG</span>
        </div>
        <p class="stat-label">Discos &amp; Barras Eleiko IWF</p>
      </div>

      <div class="stat-item stat-item--cyan reveal reveal-delay-2" role="listitem">
        <div class="stat-number-wrap">
          <span class="stat-number" data-target="98">0</span>
          <span class="stat-unit">%</span>
        </div>
        <p class="stat-label">Retención de Atletas</p>
      </div>

      <div class="stat-item stat-item--flame reveal reveal-delay-3" role="listitem">
        <div class="stat-number-wrap">
          <span class="stat-number" data-target="40">0</span>
          <span class="stat-unit">M</span>
        </div>
        <p class="stat-label">Pista de Trineo Prowler</p>
      </div>

      <div class="stat-item stat-item--titanium reveal reveal-delay-4" role="listitem">
        <div class="stat-number-wrap">
          <span class="stat-number" data-target="110">0</span>
          <span class="stat-unit">°C</span>
        </div>
        <p class="stat-label">Cámara Criogénica Celular</p>
      </div>

    </div>
  </div>
</section>

<style>
.stats {
  position: relative;
  padding-block: clamp(5.5rem, 11vw, 9rem);
  overflow: hidden;
  text-align: center;
}

.stats__bg { position: absolute; inset: 0; }

.stats__bg-img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: center 40%;
  filter: brightness(0.35) contrast(1.25) saturate(1.05);
}

.stats__overlay {
  position: absolute; inset: 0;
  background: radial-gradient(circle at center, rgba(8,12,20,0.75) 0%, rgba(5,8,14,0.98) 100%);
}

.stats__content { position: relative; z-index: 1; }
.stats__intro { margin-bottom: 4rem; }

.stats__heading {
  font-size: clamp(2.4rem, 4vw, 3.8rem);
  color: #FFFFFF;
  margin-top: 0.5rem;
}

.highlight-volt {
  background: var(--grad-volt);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.stats__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.75rem;
}

.stat-item {
  padding: 3rem 1.75rem;
  background: rgba(18, 24, 38, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(14px);
  position: relative;
  border-radius: var(--radius-md);
  transition: border-color var(--transition-base), background var(--transition-base), transform var(--transition-base);
}

.stat-item:hover {
  background: rgba(26, 35, 56, 0.95);
  transform: translateY(-8px);
}

/* Stat Items Accent Borders */
.stat-item--volt { border-bottom: 3px solid var(--color-volt); }
.stat-item--volt .stat-number { color: var(--color-volt); }
.stat-item--volt .stat-unit   { color: var(--color-cyan); }

.stat-item--cyan { border-bottom: 3px solid var(--color-cyan); }
.stat-item--cyan .stat-number { color: var(--color-cyan); }
.stat-item--cyan .stat-unit   { color: var(--color-volt); }

.stat-item--flame { border-bottom: 3px solid var(--color-flame); }
.stat-item--flame .stat-number { color: var(--color-flame); }
.stat-item--flame .stat-unit   { color: #FFFFFF; }

.stat-item--titanium { border-bottom: 3px solid #FFFFFF; }
.stat-item--titanium .stat-number { color: #FFFFFF; }
.stat-item--titanium .stat-unit   { color: var(--color-volt); }

.stat-number-wrap { display: flex; align-items: baseline; justify-content: center; gap: 4px; }

.stat-number {
  font-family: var(--font-heading);
  font-size: clamp(3.2rem, 5.5vw, 5.2rem);
  font-weight: 800;
  line-height: 1;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}

.stat-unit {
  font-family: var(--font-heading);
  font-size: clamp(1.4rem, 2.4vw, 2rem);
  font-weight: 800;
  line-height: 1;
}

.stat-label {
  margin-top: 1rem;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-cream-muted);
  line-height: 1.5;
}

@media (max-width: 900px) { .stats__grid { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; } }
@media (max-width: 480px) { .stats__grid { grid-template-columns: 1fr; } }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const counters = document.querySelectorAll<HTMLElement>('.stat-number[data-target]');
  
  if (counters.length > 0) {
    ScrollTrigger.create({
      trigger: '.stats',
      start: 'top 80%',
      once: true,
      onEnter: () => {
        counters.forEach(counter => {
          const target = parseInt(counter.dataset.target ?? '0', 10);
          gsap.to(counter, {
            innerText: target,
            duration: 2,
            ease: "power2.out",
            snap: { innerText: 1 },
            onUpdate: function() {
              counter.innerText = Math.round(Number(this.targets()[0].innerText)).toLocaleString('es-AR');
            },
            onComplete: function() {
              counter.innerText = target.toLocaleString('es-AR');
            }
          });
        });
      }
    });
  }
</script>
