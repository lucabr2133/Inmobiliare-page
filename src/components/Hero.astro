---
// Hero.astro — Editorial Brutalist Athletic Hero (No Blue, No Top Tag)
---

<section class="hud-hero" id="inicio">
  <!-- Atmospheric Background -->
  <div class="hud-hero__bg">
    <img
      src="https://images.pexels.com/photos/1552242/pexels-photo-1552242.jpeg?auto=compress&cs=tinysrgb&w=1920&h=1080&dpr=1"
      alt="Entrenamiento de alta intensidad en APEX Athletic Club"
      class="hud-hero__img"
      id="hero-img"
    />
    <div class="hud-hero__overlay"></div>
    <div class="hud-hero__scanlines"></div>
  </div>

  <div class="container hud-hero__content">
    <!-- Massive Brutalist Title (No top tag above) -->
    <h1 class="display-title hud-hero__title reveal" id="hero-title">
      HUMAN<br />
      <span class="highlight-volt">POTENTIAL</span><br />
      ENGINEERED
    </h1>

    <!-- Subtitle & Action Grid -->
    <div class="hud-hero__bottom-grid reveal">
      <div class="hud-hero__lead">
        <p>
          El primer santuario atlético de precisión biomecánica, periodización basada en HRV y biohacking celular en Buenos Aires. 2.500 m² de equipamiento olímpico Eleiko y crioterapia a -110°C.
        </p>
        <div class="hud-hero__actions">
          <a href="#vip-pass" class="btn btn-volt">
            <span>RECLAMAR 1-DAY PASS</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#zonas" class="btn btn-ghost">
            <span>EXPLORAR ZONAS</span>
          </a>
        </div>
      </div>

      <!-- Quick Telemetry HUD -->
      <div class="hud-hero__telemetry">
        <div class="telemetry-box">
          <span class="telemetry-val">2.500<small>M²</small></span>
          <span class="telemetry-lbl">SUPERFICIE OLÍMPICA</span>
        </div>
        <div class="telemetry-box">
          <span class="telemetry-val">-110<small>°C</small></span>
          <span class="telemetry-lbl">CRYO RECOVERY SPA</span>
        </div>
        <div class="telemetry-box">
          <span class="telemetry-val">15<small>TON</small></span>
          <span class="telemetry-lbl">DISCOS ELEIKO IWF</span>
        </div>
        <div class="telemetry-box">
          <span class="telemetry-val">1:1</span>
          <span class="telemetry-lbl">COACHING BIOMECÁNICO</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Live Marquee Ticker (No Blue) -->
  <div class="hud-marquee" aria-hidden="true">
    <div class="hud-marquee__inner">
      <span>⚡ ELEIKO CERTIFIED FACILITY</span>
      <span>///</span>
      <span>HYROX OFFICIAL TRAINING CLUB</span>
      <span>///</span>
      <span>-110°C WHOLE BODY CRYO</span>
      <span>///</span>
      <span>PRIME FITNESS SMARTCAM</span>
      <span>///</span>
      <span>ARSENAL STRENGTH RELOADED</span>
      <span>///</span>
      <span>BALANCED BODY ALLEGRO 2</span>
      <span>///</span>
      <span>⚡ ELEIKO CERTIFIED FACILITY</span>
      <span>///</span>
      <span>HYROX OFFICIAL TRAINING CLUB</span>
      <span>///</span>
      <span>-110°C WHOLE BODY CRYO</span>
    </div>
  </div>
</section>

<style>
.hud-hero {
  position: relative;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding-top: calc(var(--navbar-h) + 3rem);
  overflow: hidden;
  background: var(--color-bg);
}

.hud-hero__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.hud-hero__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 30%;
  filter: brightness(0.42) contrast(1.2) saturate(0.85);
}

.hud-hero__overlay {
  position: absolute;
  inset: 0;
  background: radial-gradient(
    circle at 35% 40%,
    rgba(8, 10, 14, 0.4) 0%,
    rgba(8, 10, 14, 0.88) 65%,
    #080A0E 100%
  );
}

.hud-hero__scanlines {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    rgba(18, 16, 16, 0) 50%, 
    rgba(0, 0, 0, 0.35) 50%
  );
  background-size: 100% 4px;
  pointer-events: none;
  opacity: 0.6;
}

.hud-hero__content {
  position: relative;
  z-index: 2;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-block: 2.5rem;
}

.hud-hero__title {
  font-size: clamp(3.4rem, 8.5vw, 7.5rem);
  letter-spacing: -0.03em;
  margin-bottom: 2.5rem;
}

.hud-hero__bottom-grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: clamp(2rem, 5vw, 5rem);
  align-items: end;
}

.hud-hero__lead p {
  font-size: clamp(0.95rem, 1.3vw, 1.15rem);
  line-height: 1.7;
  color: var(--color-text-muted);
  margin-bottom: 2rem;
  max-width: 540px;
}

.hud-hero__actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

/* Telemetry Box Grid */
.hud-hero__telemetry {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
}

.telemetry-box {
  background: rgba(20, 23, 30, 0.7);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-left: 3px solid var(--color-volt);
  padding: 1.15rem;
  border-radius: var(--radius-sm);
  transition: transform 0.3s ease, border-color 0.3s ease;
}

.telemetry-box:hover {
  transform: translateY(-4px);
  border-color: var(--color-volt);
}

.telemetry-val {
  font-family: var(--font-tech);
  font-size: 1.8rem;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
  display: flex;
  align-items: baseline;
  gap: 0.2rem;
  margin-bottom: 0.3rem;
}

.telemetry-val small {
  font-size: 0.85rem;
  color: var(--color-volt);
}

.telemetry-lbl {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  color: var(--color-text-muted);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

/* Marquee (No Blue) */
.hud-marquee {
  position: relative;
  z-index: 2;
  background: #10131A;
  border-top: 1px solid var(--color-border-volt);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  padding-block: 0.75rem;
  overflow: hidden;
  white-space: nowrap;
}

.hud-marquee__inner {
  display: inline-flex;
  gap: 2.5rem;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.15em;
  color: var(--color-volt);
  animation: marquee-scroll 25s linear infinite;
}

.hud-marquee__inner span:nth-child(even) {
  color: #FFFFFF;
}

@keyframes marquee-scroll {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

@media (max-width: 900px) {
  .hud-hero__bottom-grid { grid-template-columns: 1fr; }
  .hud-hero__actions .btn { width: 100%; justify-content: center; }
}
</style>

<script>
  import gsap from 'gsap';

  const revealHero = () => {
    gsap.fromTo('.hud-hero .reveal',
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: 1,
        stagger: 0.15,
        ease: 'expo.out',
        clearProps: 'transform'
      }
    );
  };

  // @ts-ignore
  if (window.isPreloaderRevealed) {
    revealHero();
  } else {
    window.addEventListener('preloaderReveal', revealHero);
    if (!document.getElementById('preloader')) revealHero();
  }
</script>
