---
---

<section class="hero" id="inicio">
  <div class="hero__bg">
    <img
      src="https://images.pexels.com/photos/323780/pexels-photo-323780.jpeg?auto=compress&cs=tinysrgb&w=1920&h=1080&dpr=1"
      alt="Arquitectura de lujo en Buenos Aires"
      class="hero__img"
    />
    <div class="hero__overlay"></div>
  </div>

  <div class="container hero__content">
    <span class="hero__label reveal">Inmobiliaria Boutique · Desde 2010</span>
    <h1 class="hero__title reveal">
      Construimos relaciones,<br /><em>no solo transacciones</em>
    </h1>
    <p class="hero__lead reveal">
      Más de 15 años asesorando a familias, inversores y empresas
      en las operaciones inmobiliarias más importantes de Buenos Aires.
    </p>
    <div class="hero__actions reveal">
      <a href="#nosotros" class="btn btn-outline-light">Conocer la firma</a>
      <a href="#contacto" class="btn btn-outline-light">Agendar reunión</a>
    </div>
  </div>
</section>

<style>
.hero {
  position: relative;
  min-height: 100svh;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.hero__bg { position: absolute; inset: 0; }

.hero__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(0.45) saturate(0.85);
  transform: scale(1.05);
}

.hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(26,26,24,0.95) 0%, rgba(26,26,24,0.4) 50%, rgba(26,26,24,0.15) 100%);
}

.hero__content {
  position: relative;
  z-index: 2;
  padding-bottom: clamp(5rem, 10vw, 8rem);
  max-width: 720px;
}

.hero__label {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-gold-light);
  margin-bottom: 1.5rem;
  display: block;
}

.hero__title {
  font-family: var(--font-display);
  font-size: clamp(2.8rem, 6.5vw, 4.8rem);
  font-weight: 400;
  color: var(--color-white);
  line-height: 1.15;
  margin-bottom: 1.5rem;
}

.hero__title em {
  font-style: italic;
  color: var(--color-gold-light);
}

.hero__lead {
  font-size: clamp(0.92rem, 1.2vw, 1.05rem);
  color: rgba(255,255,255,0.65);
  line-height: 1.75;
  max-width: 500px;
  margin-bottom: 2.5rem;
  font-weight: 300;
}

.hero__actions { display: flex; gap: 1rem; flex-wrap: wrap; }

@media (max-width: 768px) {
  .hero__actions .btn { width: 100%; justify-content: center; }
}
</style>

<script>
  import gsap from 'gsap';

  const revealHero = () => {
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
    tl.to('.hero__img', { scale: 1, duration: 1.8, ease: 'power2.out' })
      .fromTo('.hero__label', { opacity: 0, y: 15 }, { opacity: 1, y: 0, duration: 0.7 }, 0.4)
      .fromTo('.hero__title', { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 1 }, 0.6)
      .fromTo('.hero__lead', { opacity: 0, y: 25 }, { opacity: 1, y: 0, duration: 0.8 }, 0.9)
      .fromTo('.hero__actions', { opacity: 0, y: 15 }, { opacity: 1, y: 0, duration: 0.7 }, 1.1);
  };

  // @ts-ignore
  if (window.isPreloaderRevealed) revealHero();
  else {
    window.addEventListener('preloaderReveal', revealHero);
    if (!document.getElementById('preloader')) revealHero();
  }
</script>
