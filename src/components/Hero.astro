---
// Hero.astro — Cinematic Landing Hero with GSAP animations
---

<section class="hero" id="inicio">
  <div class="hero__bg">
    <img
      src="https://images.pexels.com/photos/1552242/pexels-photo-1552242.jpeg?auto=compress&cs=tinysrgb&w=1920&h=1080&dpr=1"
      alt="APEX Athletic Club - Entrenamiento de alto rendimiento"
      class="hero__img"
    />
    <div class="hero__overlay"></div>
  </div>

  <div class="container hero__content">
    <h1 class="hero__title reveal">
      TU MEJOR<br />
      <span class="highlight-volt">VERSIÓN</span><br />
      EMPIEZA ACÁ
    </h1>

    <p class="hero__lead reveal">
      El primer santuario atlético de precisión biomecánica, periodización basada en HRV
      y biohacking celular en Buenos Aires. 2.500 m² de puro rendimiento.
    </p>

    <div class="hero__actions reveal">
      <a href="#contacto" class="btn btn-volt">
        <span>EMPEZAR AHORA</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="#servicios" class="btn btn-ghost">
        <span>VER SERVICIOS</span>
      </a>
    </div>

    <div class="hero__stats reveal">
      <div class="hero__stat">
        <span class="hero__stat-val">2.500<small>m²</small></span>
        <span class="hero__stat-lbl">Superficie Total</span>
      </div>
      <div class="hero__stat">
        <span class="hero__stat-val">-110<small>°C</small></span>
        <span class="hero__stat-lbl">Cámara Crioterapia</span>
      </div>
      <div class="hero__stat">
        <span class="hero__stat-val">15<small>ton</small></span>
        <span class="hero__stat-lbl">Equipamiento Eleiko</span>
      </div>
      <div class="hero__stat">
        <span class="hero__stat-val">1:1</span>
        <span class="hero__stat-lbl">Coaching Personal</span>
      </div>
    </div>
  </div>

  <div class="hero__scroll-cue">
    <span>SCROLL</span>
    <div class="hero__scroll-line"></div>
  </div>
</section>

<style>
.hero {
  position: relative;
  min-height: 100svh;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.hero__bg {
  position: absolute;
  inset: 0;
}

.hero__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 30%;
  filter: brightness(0.35) contrast(1.15) saturate(0.9);
}

.hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(10, 10, 10, 0.3) 0%,
    rgba(10, 10, 10, 0.6) 50%,
    #0A0A0A 100%
  );
}

.hero__content {
  position: relative;
  z-index: 2;
  padding-top: calc(var(--navbar-h) + 4rem);
  padding-bottom: 6rem;
}

.hero__title {
  font-family: var(--font-display);
  font-size: clamp(3rem, 8vw, 6.5rem);
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.05;
  letter-spacing: -0.03em;
  margin-bottom: 1.5rem;
}

.hero__lead {
  font-size: clamp(1rem, 1.4vw, 1.2rem);
  color: var(--color-text-muted);
  line-height: 1.7;
  max-width: 550px;
  margin-bottom: 2.5rem;
}

.hero__actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 4rem;
}

.hero__stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
  max-width: 700px;
}

.hero__stat {
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-left: 3px solid var(--color-volt);
  padding: 1rem 1.25rem;
  border-radius: 4px;
}

.hero__stat-val {
  font-family: var(--font-tech);
  font-size: 1.6rem;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  line-height: 1.2;
}

.hero__stat-val small {
  font-size: 0.8rem;
  color: var(--color-volt);
  margin-left: 2px;
}

.hero__stat-lbl {
  font-family: var(--font-mono);
  font-size: 0.6rem;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.hero__scroll-cue {
  position: absolute;
  bottom: 2rem;
  right: var(--container-pad);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  z-index: 5;
}

.hero__scroll-cue span {
  font-family: var(--font-mono);
  font-size: 0.6rem;
  color: var(--color-text-muted);
  letter-spacing: 0.2em;
  writing-mode: vertical-rl;
}

.hero__scroll-line {
  width: 1px;
  height: 60px;
  background: linear-gradient(to bottom, var(--color-volt), transparent);
  animation: scroll-pulse 2s ease-in-out infinite;
}

@keyframes scroll-pulse {
  0%, 100% { opacity: 1; transform: scaleY(1); }
  50% { opacity: 0.3; transform: scaleY(0.6); }
}

@media (max-width: 768px) {
  .hero__stats { grid-template-columns: repeat(2, 1fr); }
  .hero__actions .btn { width: 100%; justify-content: center; }
}
</style>

<script>
  import gsap from 'gsap';

  const revealHero = () => {
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
    
    tl.fromTo('.hero__title', { opacity: 0, y: 60 }, { opacity: 1, y: 0, duration: 1 })
      .fromTo('.hero__lead', { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.8 }, '-=0.5')
      .fromTo('.hero__actions', { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.7 }, '-=0.4')
      .fromTo('.hero__stat', { opacity: 0, y: 25, scale: 0.95 }, { opacity: 1, y: 0, scale: 1, duration: 0.6, stagger: 0.1 }, '-=0.3')
      .fromTo('.hero__scroll-cue', { opacity: 0 }, { opacity: 1, duration: 0.5 }, '-=0.2');
  };

  // @ts-ignore
  if (window.isPreloaderRevealed) {
    revealHero();
  } else {
    window.addEventListener('preloaderReveal', revealHero);
    if (!document.getElementById('preloader')) revealHero();
  }
</script>
