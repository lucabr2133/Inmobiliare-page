---
// AthletesWall.astro — The Wall of Proof & Telemetry (No Blue, No Top Tag)
const proofs = [
  {
    athlete: 'Lucas B.',
    role: 'TECH FOUNDER & HYROX PRO',
    badge: '18 MESES EN APEX',
    stats: [
      { num: '57:42', lbl: 'HYROX PRO TIME' },
      { num: '+24%', lbl: 'INCREMENTO HRV' },
      { num: '-11%', lbl: 'MASA GRASA' }
    ],
    quote: 'El entrenamiento guiado por variabilidad cardíaca y las sesiones post-carrera a -110°C me permitieron clasificar al Campeonato Mundial sin una sola lesión.',
    image: 'https://images.pexels.com/photos/1552249/pexels-photo-1552249.jpeg?auto=compress&cs=tinysrgb&w=500&h=600&dpr=1'
  },
  {
    athlete: 'Martina S.',
    role: 'HALTEROFILIA & POWERLIFTING',
    badge: '12 MESES EN APEX',
    stats: [
      { num: '+32 KG', lbl: 'DEADLIFT TOTAL' },
      { num: '95 KG', lbl: 'SNATCH PR' },
      { num: '0.0', lbl: 'DOLOR ARTICULAR' }
    ],
    quote: 'Las plataformas Eleiko y la corrección de palancas articulares cambiaron por completo mi sentadilla. Pasé de estancarme con dolor lumbar a superar mis marcas históricas.',
    image: 'https://images.pexels.com/photos/3757954/pexels-photo-3757954.jpeg?auto=compress&cs=tinysrgb&w=500&h=600&dpr=1'
  },
  {
    athlete: 'Dr. Alejandro V.',
    role: 'CIRUJANO CARDIOVASCULAR',
    badge: '24 MESES EN APEX',
    stats: [
      { num: '48 BPM', lbl: 'RHR EN REPOSO' },
      { num: '+8.2 KG', lbl: 'MASA MUSCULAR' },
      { num: '100%', lbl: 'ENERGÍA DIARIA' }
    ],
    quote: 'Entiendo la fisiología detrás de este club. La combinación de saunas infrarrojos, contrastes térmicos y sobrecarga progresiva es la medicina preventiva más potente que existe.',
    image: 'https://images.pexels.com/photos/1222271/pexels-photo-1222271.jpeg?auto=compress&cs=tinysrgb&w=500&h=600&dpr=1'
  }
];
---

<section class="section wall" id="atletas">
  <div class="container">
    <div class="wall__head reveal">
      <h2 class="display-title wall__title">
        WALL OF <span class="highlight-volt">PROOF</span>
      </h2>
      <p class="wall__desc">
        Datos biométricos y transformaciones reales registradas en nuestras evaluaciones mensuales InBody 770.
      </p>
    </div>

    <!-- Wall Cards Grid -->
    <div class="wall__grid reveal">
      {proofs.map(p => (
        <div class="proof-card">
          <div class="proof-card__top">
            <img src={p.image} alt={p.athlete} class="proof-card__avatar" loading="lazy" />
            <div>
              <span class="proof-athlete">{p.athlete}</span>
              <span class="proof-role">{p.role}</span>
              <span class="proof-badge">{p.badge}</span>
            </div>
          </div>

          <blockquote class="proof-quote">
            "{p.quote}"
          </blockquote>

          <div class="proof-metrics-grid">
            {p.stats.map(s => (
              <div class="proof-metric-box">
                <span class="p-num">{s.num}</span>
                <span class="p-lbl">{s.lbl}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.wall {
  background: var(--color-bg-alt);
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.wall__head {
  max-width: 650px;
  margin-bottom: 3.5rem;
}

.wall__title {
  font-size: clamp(2.6rem, 5vw, 4.5rem);
  margin-bottom: 1rem;
}

.wall__desc {
  font-size: 0.95rem;
  color: var(--color-text-muted);
  line-height: 1.7;
}

/* Grid */
.wall__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}

.proof-card {
  background: #080A0E;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-md);
  padding: 2.25rem 2rem;
  display: flex;
  flex-direction: column;
  transition: transform 0.3s ease, border-color 0.3s ease;
}

.proof-card:hover {
  transform: translateY(-8px);
  border-color: var(--color-volt);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9), 0 0 25px rgba(217, 255, 0, 0.15);
}

.proof-card__top {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  margin-bottom: 1.5rem;
}

.proof-card__avatar {
  width: 64px;
  height: 64px;
  border-radius: var(--radius-sm);
  object-fit: cover;
  border: 2px solid var(--color-volt);
  box-shadow: 0 0 15px rgba(217, 255, 0, 0.4);
}

.proof-athlete {
  font-family: var(--font-tech);
  font-size: 1.25rem;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
}

.proof-role {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--color-volt);
  display: block;
  margin-block: 0.2rem;
}

.proof-badge {
  font-family: var(--font-mono);
  font-size: 0.58rem;
  color: var(--color-text-muted);
  background: rgba(255, 255, 255, 0.05);
  padding: 0.15rem 0.45rem;
  border-radius: var(--radius-sm);
}

.proof-quote {
  font-size: 0.88rem;
  color: var(--color-titanium);
  line-height: 1.65;
  margin-bottom: 2rem;
  flex: 1;
}

.proof-metrics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.5rem;
  background: rgba(20, 23, 30, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.06);
  padding: 0.85rem 0.5rem;
  border-radius: var(--radius-sm);
  text-align: center;
}

.p-num {
  font-family: var(--font-tech);
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--color-volt);
  display: block;
}

.p-lbl {
  font-family: var(--font-mono);
  font-size: 0.55rem;
  color: var(--color-text-muted);
  display: block;
  margin-top: 0.15rem;
}

@media (max-width: 1024px) {
  .wall__grid { grid-template-columns: 1fr; }
}
</style>
