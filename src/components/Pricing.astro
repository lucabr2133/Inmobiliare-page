---
// Pricing.astro — Planes y membresías
---

<section class="pricing" id="membresias">
  <div class="container">
    <div class="pricing__header">
      <h2 class="section-title reveal">ELEGÍ TU <span class="highlight-volt">PLAN</span></h2>
      <p class="section-subtitle reveal">
        Membresías flexibles diseñadas para cada nivel de compromiso atlético.
      </p>
    </div>

    <div class="pricing__grid">
      <div class="price-card reveal">
        <div class="price-card__head">
          <h3>STARTER</h3>
          <div class="price-card__price">
            <span class="price-card__amount">$45.000</span>
            <span class="price-card__period">/mes</span>
          </div>
        </div>
        <ul class="price-card__features">
          <li>Acceso zona de musculación</li>
          <li>Clases grupales básicas</li>
          <li>Vestuario con locker</li>
          <li>App de seguimiento</li>
        </ul>
        <a href="#contacto" class="btn btn-ghost" style="width:100%;">ELEGIR PLAN</a>
      </div>

      <div class="price-card price-card--featured reveal">
        <div class="price-card__badge">MÁS POPULAR</div>
        <div class="price-card__head">
          <h3>PERFORMANCE</h3>
          <div class="price-card__price">
            <span class="price-card__amount">$85.000</span>
            <span class="price-card__period">/mes</span>
          </div>
        </div>
        <ul class="price-card__features">
          <li>Acceso total a todas las zonas</li>
          <li>Todas las clases y disciplinas</li>
          <li>1 sesión de coaching /semana</li>
          <li>Análisis biomecánico mensual</li>
          <li>2 sesiones de crioterapia /mes</li>
          <li>Nutrición deportiva guiada</li>
        </ul>
        <a href="#contacto" class="btn btn-volt" style="width:100%;">ELEGIR PLAN</a>
      </div>

      <div class="price-card reveal">
        <div class="price-card__head">
          <h3>ÉLITE</h3>
          <div class="price-card__price">
            <span class="price-card__amount">$150.000</span>
            <span class="price-card__period">/mes</span>
          </div>
        </div>
        <ul class="price-card__features">
          <li>Todo lo de Performance</li>
          <li>Coaching 1-on-1 ilimitado</li>
          <li>Crioterapia ilimitada</li>
          <li>Acceso VIP 24/7</li>
          <li>Plan de periodización personal</li>
          <li>Invitado/a incluido/a</li>
        </ul>
        <a href="#contacto" class="btn btn-ghost" style="width:100%;">ELEGIR PLAN</a>
      </div>
    </div>
  </div>
</section>

<style>
.pricing {
  background: #080808;
}

.pricing__header {
  text-align: center;
  margin-bottom: clamp(3rem, 5vw, 4rem);
}

.pricing__header .section-subtitle { margin-inline: auto; }

.pricing__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  align-items: start;
}

.price-card {
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: 12px;
  padding: 2rem;
  position: relative;
  transition: all 0.35s ease;
}

.price-card:hover {
  border-color: var(--color-border-volt);
  transform: translateY(-4px);
}

.price-card--featured {
  border-color: var(--color-volt);
  background: linear-gradient(to bottom, rgba(217,255,0,0.04), var(--color-bg-card));
  transform: scale(1.04);
}

.price-card--featured:hover {
  transform: scale(1.04) translateY(-4px);
}

.price-card__badge {
  position: absolute;
  top: -1px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--color-volt);
  color: #0A0A0A;
  font-family: var(--font-mono);
  font-size: 0.65rem;
  font-weight: 800;
  padding: 0.3rem 1rem;
  border-radius: 0 0 6px 6px;
  letter-spacing: 0.08em;
}

.price-card__head {
  margin-bottom: 1.5rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--color-border);
}

.price-card__head h3 {
  font-family: var(--font-tech);
  font-size: 1.2rem;
  color: #FFFFFF;
  margin-bottom: 0.75rem;
  letter-spacing: 0.05em;
}

.price-card__amount {
  font-family: var(--font-display);
  font-size: 2.5rem;
  font-weight: 800;
  color: #FFFFFF;
}

.price-card__period {
  font-size: 0.9rem;
  color: var(--color-text-muted);
}

.price-card__features {
  list-style: none;
  margin-bottom: 2rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.price-card__features li {
  font-size: 0.9rem;
  color: var(--color-text-muted);
  padding-left: 1.5rem;
  position: relative;
}

.price-card__features li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8px;
  height: 8px;
  background: var(--color-volt);
  border-radius: 2px;
}

@media (max-width: 900px) {
  .pricing__grid { grid-template-columns: 1fr; max-width: 450px; margin-inline: auto; }
  .price-card--featured { transform: none; }
  .price-card--featured:hover { transform: translateY(-4px); }
}
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray('.price-card').forEach((card: any, i: number) => {
    gsap.fromTo(card,
      { opacity: 0, y: 50 },
      {
        opacity: 1, y: 0, duration: 0.7,
        delay: i * 0.12,
        ease: 'power2.out',
        scrollTrigger: { trigger: card, start: 'top 85%' }
      }
    );
  });
</script>
