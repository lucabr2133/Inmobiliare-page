---
// Pricing.astro — APEX Performance Club Membership Plans
---

<section class="section pricing" id="membresias" aria-labelledby="pricing-heading">
  <div class="container">
    <div class="pricing__header reveal">
      <span class="eyebrow">PLANES &amp; ACCESOS EXCLUSIVOS</span>
      <span class="volt-line"></span>
      <h2 class="display-heading pricing__heading" id="pricing-heading">
        Membresías de <span class="highlight-volt">Élite</span>
      </h2>
      <p class="pricing__desc">
        Aforo limitado por turno para garantizar espacio, privacidad y disponibilidad absoluta de equipamiento olímpico.
      </p>

      <!-- Billing Toggle Switch -->
      <div class="billing-toggle" role="group" aria-label="Frecuencia de facturación">
        <span class="billing-toggle__label active" id="label-monthly">Mensual</span>
        <button class="billing-toggle__switch" id="billing-switch" aria-label="Alternar facturación mensual y anual" role="switch" aria-checked="false">
          <span class="billing-toggle__knob"></span>
        </button>
        <span class="billing-toggle__label" id="label-annual">
          Anual <span class="badge-discount">-20% OFF</span>
        </span>
      </div>
    </div>

    <!-- Pricing Grid -->
    <div class="pricing__grid" role="list">

      <!-- Plan 1: Silver -->
      <div class="pricing-card pricing-card--silver reveal reveal-delay-1" role="listitem">
        <div class="pricing-card__head">
          <span class="plan-type">ACCESO BASE</span>
          <h3 class="plan-name">Silver Access</h3>
          <p class="plan-summary">Para atletas que buscan entrenamiento autónomo de máxima exigencia.</p>
          <div class="plan-price-wrap">
            <span class="currency">$</span>
            <span class="price-val" data-monthly="55.000" data-annual="44.000">55.000</span>
            <span class="period">/ mes</span>
          </div>
        </div>

        <ul class="plan-features">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Acceso ilimitado a <strong>The Iron Temple</strong> &amp; Hypertrophy</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Uso de equipamiento olímpico Eleiko &amp; Arsenal</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>App APEX: Rutinas &amp; métricas biométricas</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Vestuarios de lujo con toallas y amenities</span>
          </li>
        </ul>

        <div class="pricing-card__cta">
          <a href="#contacto" class="btn btn-outline" style="width:100%;justify-content:center;">
            <span>Elegir Silver</span>
          </a>
        </div>
      </div>

      <!-- Plan 2: Black Diamond (Popular / Highlighted) -->
      <div class="pricing-card pricing-card--featured reveal reveal-delay-2" role="listitem">
        <div class="featured-badge">⚡ EL MÁS ELEGIDO · ALL-ACCESS</div>
        <div class="pricing-card__head">
          <span class="plan-type" style="color: var(--color-volt);">ALL-INCLUSIVE SANCTUARY</span>
          <h3 class="plan-name">Black Diamond</h3>
          <p class="plan-summary">Acceso total a todas las zonas, clases de autor y biohacking de recuperación.</p>
          <div class="plan-price-wrap">
            <span class="currency">$</span>
            <span class="price-val" data-monthly="89.000" data-annual="71.000">89.000</span>
            <span class="period">/ mes</span>
          </div>
        </div>

        <ul class="plan-features">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span><strong>Acceso 100% Ilimitado</strong> a las 6 Zonas APEX</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Clases de autor: Hyrox, Weightlifting &amp; Boxing</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>2 Sesiones mensuales de <strong>Crioterapia -110°C &amp; Sauna</strong></span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Evaluación biomecánica 3D &amp; Composición InBody</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>4 Pases de Invitado VIP por mes</span>
          </li>
        </ul>

        <div class="pricing-card__cta">
          <a href="#contacto" class="btn btn-volt" style="width:100%;justify-content:center;">
            <span>Elegir Black Diamond</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Plan 3: VIP Private -->
      <div class="pricing-card pricing-card--vip reveal reveal-delay-3" role="listitem">
        <div class="pricing-card__head">
          <span class="plan-type" style="color: var(--color-cyan);">HAUTE PERFORMANCE</span>
          <h3 class="plan-name">Apex Private VIP</h3>
          <p class="plan-summary">La experiencia definitiva con head coach dedicado 1-on-1 y concierge.</p>
          <div class="plan-price-wrap">
            <span class="currency">$</span>
            <span class="price-val" data-monthly="160.000" data-annual="128.000">160.000</span>
            <span class="period">/ mes</span>
          </div>
        </div>

        <ul class="plan-features">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Todo lo incluido en <strong>Black Diamond</strong></span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span><strong>8 Sesiones 1-on-1</strong> con Head Coach exclusivo</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Acceso ilimitado a Cryo Spa, Saunas &amp; Ice Baths</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Locker privado con nombre, Valet Parking &amp; Shakes libres</span>
          </li>
        </ul>

        <div class="pricing-card__cta">
          <a href="#contacto" class="btn btn-outline-cyan" style="width:100%;justify-content:center;">
            <span>Aplicar a Membresía VIP</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
.pricing {
  background: var(--color-bg-alt);
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  position: relative;
}

.pricing__header {
  text-align: center;
  max-width: 680px;
  margin-inline: auto;
  margin-bottom: 4rem;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pricing__heading {
  font-size: clamp(2.4rem, 4.5vw, 3.8rem);
  color: #FFFFFF;
  margin-bottom: 1rem;
}

.highlight-volt {
  background: var(--grad-volt);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.pricing__desc {
  color: var(--color-cream-muted);
  font-size: var(--fs-md);
  line-height: var(--lh-loose);
  margin-bottom: 2rem;
}

/* Toggle */
.billing-toggle {
  display: inline-flex;
  align-items: center;
  gap: 1rem;
  background: rgba(18, 24, 38, 0.8);
  border: 1px solid rgba(255, 255, 255, 0.12);
  padding: 0.5rem 1.25rem;
  border-radius: var(--radius-pill);
}

.billing-toggle__label {
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-cream-muted);
  transition: color 0.3s ease;
}

.billing-toggle__label.active {
  color: #FFFFFF;
}

.badge-discount {
  background: var(--color-volt);
  color: #080C14;
  font-size: 0.65rem;
  font-weight: 800;
  padding: 0.15rem 0.45rem;
  border-radius: var(--radius-pill);
  margin-left: 0.35rem;
}

.billing-toggle__switch {
  width: 52px;
  height: 28px;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 9999px;
  position: relative;
  transition: background 0.3s ease;
}

.billing-toggle__switch.active {
  background: var(--color-volt);
}

.billing-toggle__knob {
  position: absolute;
  top: 3px;
  left: 4px;
  width: 22px;
  height: 22px;
  background: #FFFFFF;
  border-radius: 50%;
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease;
  box-shadow: 0 2px 6px rgba(0,0,0,0.4);
}

.billing-toggle__switch.active .billing-toggle__knob {
  transform: translateX(22px);
  background: #080C14;
}

/* Grid */
.pricing__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  align-items: stretch;
}

/* Card */
.pricing-card {
  background: var(--color-bg-card);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-md);
  padding: 2.5rem 2rem;
  display: flex;
  flex-direction: column;
  position: relative;
  transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
}

.pricing-card:hover {
  transform: translateY(-8px);
}

.pricing-card--silver:hover {
  border-color: rgba(255, 255, 255, 0.3);
  box-shadow: 0 20px 50px rgba(0,0,0,0.8);
}

.pricing-card--featured {
  background: linear-gradient(180deg, rgba(26, 35, 56, 0.95) 0%, rgba(18, 24, 38, 0.95) 100%);
  border: 1.5px solid var(--color-volt);
  box-shadow: 0 15px 40px rgba(0,0,0,0.8), 0 0 35px rgba(204, 255, 0, 0.2);
}

.pricing-card--featured:hover {
  box-shadow: 0 25px 60px rgba(0,0,0,0.9), 0 0 45px rgba(204, 255, 0, 0.4);
}

.featured-badge {
  position: absolute;
  top: -14px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--color-volt);
  color: #080C14;
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 0.35rem 1rem;
  border-radius: var(--radius-pill);
  box-shadow: 0 4px 15px rgba(204, 255, 0, 0.5);
  white-space: nowrap;
}

.pricing-card--vip:hover {
  border-color: var(--color-cyan);
  box-shadow: 0 20px 50px rgba(0,0,0,0.8), 0 0 35px rgba(0, 240, 255, 0.35);
}

/* Head */
.pricing-card__head {
  padding-bottom: 2rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  margin-bottom: 2rem;
}

.plan-type {
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--color-cream-muted);
  display: block;
  margin-bottom: 0.4rem;
}

.plan-name {
  font-family: var(--font-heading);
  font-size: 1.6rem;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 0.6rem;
  text-transform: uppercase;
}

.plan-summary {
  font-size: 0.82rem;
  color: var(--color-cream-muted);
  line-height: 1.5;
  margin-bottom: 1.5rem;
  min-height: 2.5rem;
}

.plan-price-wrap {
  display: flex;
  align-items: baseline;
  gap: 0.25rem;
}

.currency {
  font-size: 1.35rem;
  font-weight: 800;
  color: var(--color-volt);
}

.price-val {
  font-family: var(--font-heading);
  font-size: 2.5rem;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1;
}

.period {
  font-size: 0.8rem;
  color: var(--color-cream-muted);
  font-weight: 600;
}

/* Features */
.plan-features {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-bottom: 2.5rem;
  flex: 1;
}

.plan-features li {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  font-size: 0.85rem;
  color: #E2E8F0;
  line-height: 1.5;
}

.plan-features li svg {
  color: var(--color-volt);
  flex-shrink: 0;
  margin-top: 0.15rem;
}

.pricing-card__cta {
  margin-top: auto;
}

@media (max-width: 992px) {
  .pricing__grid { grid-template-columns: 1fr; max-width: 500px; margin-inline: auto; }
}
</style>

<script>
  const billingSwitch = document.getElementById('billing-switch');
  const labelMonthly  = document.getElementById('label-monthly');
  const labelAnnual   = document.getElementById('label-annual');
  const priceElements = document.querySelectorAll<HTMLElement>('.price-val');

  let isAnnual = false;

  billingSwitch?.addEventListener('click', () => {
    isAnnual = !isAnnual;
    billingSwitch.classList.toggle('active', isAnnual);
    billingSwitch.setAttribute('aria-checked', String(isAnnual));

    labelMonthly?.classList.toggle('active', !isAnnual);
    labelAnnual?.classList.toggle('active', isAnnual);

    priceElements.forEach(el => {
      const val = isAnnual ? el.dataset.annual : el.dataset.monthly;
      if (val) el.innerText = val;
    });
  });
</script>
