---
// Coaches.astro — Team / Coaches section
---

<section class="coaches" id="coaches">
  <div class="container">
    <div class="coaches__header">
      <h2 class="section-title reveal">NUESTRO <span class="highlight-volt">EQUIPO</span></h2>
      <p class="section-subtitle reveal">
        Coaches con certificaciones internacionales y más de 10 años de experiencia en alto rendimiento.
      </p>
    </div>

    <div class="coaches__grid">
      <div class="coach-card reveal">
        <div class="coach-card__img-wrap">
          <img src="https://images.pexels.com/photos/6456300/pexels-photo-6456300.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Coach Martín Vega" />
        </div>
        <div class="coach-card__info">
          <h3>Martín Vega</h3>
          <span class="coach-card__role">Head Coach — Halterofilia</span>
          <p>Ex selección Argentina, certificado IWF Level 3. 12 años formando atletas de competición.</p>
        </div>
      </div>

      <div class="coach-card reveal">
        <div class="coach-card__img-wrap">
          <img src="https://images.pexels.com/photos/6740174/pexels-photo-6740174.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Coach Valentina Ross" />
        </div>
        <div class="coach-card__info">
          <h3>Valentina Ross</h3>
          <span class="coach-card__role">HYROX & MetCon Specialist</span>
          <p>Top 10 HYROX World Championship. Especialista en conditioning y preparación funcional.</p>
        </div>
      </div>

      <div class="coach-card reveal">
        <div class="coach-card__img-wrap">
          <img src="https://images.pexels.com/photos/6551174/pexels-photo-6551174.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Coach Lucas Ferraro" />
        </div>
        <div class="coach-card__info">
          <h3>Lucas Ferraro</h3>
          <span class="coach-card__role">Strength & Biomechanics</span>
          <p>Kinesiólogo UBA, CSCS. Especialista en análisis biomecánico 3D y prevención de lesiones.</p>
        </div>
      </div>

      <div class="coach-card reveal">
        <div class="coach-card__img-wrap">
          <img src="https://images.pexels.com/photos/3822906/pexels-photo-3822906.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Coach Camila Stein" />
        </div>
        <div class="coach-card__info">
          <h3>Camila Stein</h3>
          <span class="coach-card__role">Recovery & Longevity</span>
          <p>Especialista en crioterapia, nutrición deportiva y protocolos de biohacking celular.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.coaches {
  background: var(--color-bg);
}

.coaches__header {
  text-align: center;
  margin-bottom: clamp(3rem, 5vw, 4rem);
}

.coaches__header .section-subtitle { margin-inline: auto; }

.coaches__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
}

.coach-card {
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: 8px;
  overflow: hidden;
  transition: all 0.35s ease;
}

.coach-card:hover {
  border-color: var(--color-border-volt);
  transform: translateY(-6px);
}

.coach-card__img-wrap {
  overflow: hidden;
  height: 260px;
}

.coach-card__img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top;
  transition: transform 0.5s ease;
  filter: grayscale(30%);
}

.coach-card:hover .coach-card__img-wrap img {
  transform: scale(1.05);
  filter: grayscale(0%);
}

.coach-card__info {
  padding: 1.25rem;
}

.coach-card__info h3 {
  font-family: var(--font-tech);
  font-size: 1.1rem;
  color: #FFFFFF;
  margin-bottom: 0.2rem;
}

.coach-card__role {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--color-volt);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  display: block;
  margin-bottom: 0.6rem;
}

.coach-card__info p {
  font-size: 0.85rem;
  color: var(--color-text-muted);
  line-height: 1.5;
}

@media (max-width: 1024px) {
  .coaches__grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 600px) {
  .coaches__grid { grid-template-columns: 1fr; }
}
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray('.coach-card').forEach((card: any, i: number) => {
    gsap.fromTo(card,
      { opacity: 0, y: 40 },
      {
        opacity: 1, y: 0, duration: 0.7,
        delay: i * 0.1,
        ease: 'power2.out',
        scrollTrigger: { trigger: card, start: 'top 88%' }
      }
    );
  });
</script>
